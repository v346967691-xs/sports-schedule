<!-- 离屏 canvas：转发前画分享卡用 -->
<canvas type="2d" id="share-canvas" class="share-canvas"></canvas>

<view class="paper">

  <!-- 报头 -->
  <view class="masthead">
    <view class="mast-title-row">
      <view class="mast-title">闪现赛程日报</view>
      <button class="brief-share" open-type="share">分享好友</button>
    </view>
    <view class="rule-double"></view>
    <view class="mast-meta">
      <text wx:if="{{cur}}">{{pubText}}　{{cur.kindZh}}　{{cur.windowLabel}}</text>
      <text wx:else>每日 06:00 / 21:00 出报</text>
    </view>
    <view class="rule"></view>
  </view>

  <!-- 期次翻阅 -->
  <!-- 2026-10-03 三轮真机反馈，都改了：
       ① 措辞 —— 右端原写「更新」，中文里默认读作「刷新」（gēng xīn），像坏掉的刷新按钮。
       ② 样式 —— 边界页把其中一个按钮单独淡下去，两端长得不一样；现在**任何一页都完全一致**，
          边界反馈交给 js 的 toast。
       ③ 🔴 **左右方向曾经配反**（最容易踩）：序列里 `idx 0 = 最新`，越往后越旧。
          所以 **`idx-1` 是更新的那一期、`idx+1` 是更旧（更早）的那一期**。
          上一版把左端写成「更早」（而它实际跳向更新），用户点「较新」却被带到更早的一期。
          现在按**期刊语序**命名 —— 「上期」= 时间更早的那一期、「下期」= 时间更晚的那一期：
            左端 ← 下期（onPrev，idx-1，指向更新的）
            右端 上期 →（onNext，idx+1，指向更早的）
          ⚠️ 文案和 bindtap 是**一对要有也对**的约束，`tools/smoke.js` 有守卫，
             改文案时必须同步确认它绑的是哪个方法。 -->
  <view class="pager" wx:if="{{list.length > 1}}">
    <!-- 两端样式完全一致，不做「禁用态」灰化（2026-10-03 用户要求）：
         到边界时由 js 弹一句 toast，而不是把按钮变暗。 -->
    <view class="pager-btn"
          hover-class="pager-btn-hover"
          hover-stay-time="80"
          bindtap="onPrev">← 下期</view>
    <view class="pager-pos">{{idx + 1}} / {{list.length}}</view>
    <view class="pager-btn"
          hover-class="pager-btn-hover"
          hover-stay-time="80"
          bindtap="onNext">上期 →</view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在取报…</view>
  <view class="empty" wx:elif="{{errTip}}">{{errTip}}</view>

  <block wx:elif="{{cur}}">

    <!-- 战报 -->
    <block wx:if="{{cur.mode === 'report' && cur.headline}}">
      <view class="kicker">今日头条</view>
      <view class="headline" bindtap="onHeadlineTap">
        <view class="hl-title">{{cur.headline.title}}</view>
        <view class="hl-lead">{{cur.headline.lead}}</view>

        <view class="hl-body">
          <view class="para" wx:for="{{cur.headline.body}}" wx:key="*this">{{item}}</view>
        </view>

        <!-- 数据栏：纯数据，报纸的「技术统计」区 -->
        <view class="factbox" wx:if="{{cur.headline.factbox}}">
          <view class="fb-row fb-head">
            <text class="fb-team">{{cur.headline.factbox.home.zh}}</text>
            <text class="fb-score">{{cur.headline.factbox.home.score}} - {{cur.headline.factbox.away.score}}</text>
            <text class="fb-team right">{{cur.headline.factbox.away.zh}}</text>
          </view>
          <view class="fb-row">
            <text class="fb-k">{{cur.headline.factbox.comp}}</text>
            <text class="fb-v">{{cur.headline.factbox.stage}}</text>
          </view>
          <view class="fb-row">
            <text class="fb-k">开赛</text>
            <text class="fb-v">{{cur.headline.factbox.time}}</text>
          </view>
          <view class="fb-row" wx:if="{{cur.headline.factbox.venue}}">
            <text class="fb-k">场地</text>
            <text class="fb-v">{{cur.headline.factbox.venue}}</text>
          </view>
        </view>
      </view>

      <block wx:if="{{cur.briefs.length}}">
        <view class="kicker">同期简讯</view>
        <view class="briefs">
          <view class="brief-item" wx:for="{{cur.briefs}}" wx:key="matchId"
                data-id="{{item.matchId}}" bindtap="onBriefTap">
            <text class="bf-line">{{item.line}}</text>
            <text class="bf-tag" wx:if="{{item.narrativeZh}}">{{item.narrativeZh}}</text>
          </view>
        </view>
      </block>
    </block>

    <!-- 前瞻（空窗日） -->
    <block wx:elif="{{cur.mode === 'preview' && cur.preview}}">
      <!-- 晚报的 tag 是「今夜看点」，早报前瞻没有 tag，退回「赛事前瞻」 -->
      <view class="kicker">{{cur.preview.tag || '赛事前瞻'}}</view>
      <view class="pv-intro">{{cur.preview.intro}}</view>

      <block wx:for="{{cur.preview.items}}" wx:key="matchId">
        <view class="pv-gtitle" wx:if="{{item.groupZh && (index === 0 || cur.preview.items[index-1].group !== item.group)}}">{{item.groupZh}}</view>
        <view class="pv-item" data-id="{{item.matchId}}" bindtap="onPreviewTap">
          <view class="pv-top">
            <text class="pv-time">{{item.time}}</text>
            <text class="pv-comp">{{item.comp}}</text>
          </view>
          <view class="pv-teams">{{item.home}} vs {{item.away}}</view>
          <view class="pv-foot">
            <text class="pv-why" wx:if="{{item.why}}">{{item.why}}</text>
            <!-- 纳入「正在进行」的比赛后，relative 可能是「进行中」，不能再拼「开赛」 -->
            <text class="pv-rel">{{item.relative === '进行中' ? item.relative : item.relative + '开赛'}}</text>
          </view>
        </view>
      </block>
    </block>

    <!-- 无素材 -->
    <block wx:else>
      <view class="empty">{{cur.note || '本期没有可展示的内容'}}</view>
    </block>

    <!-- AI 生成标识（合规强制） -->
    <view class="aigc" wx:if="{{cur.aigc}}">
      <text class="aigc-tag">{{cur.aigc.explicit}}</text>
      <text class="aigc-note">{{cur.aigc.explicitNote}}</text>
    </view>

  </block>

</view>
