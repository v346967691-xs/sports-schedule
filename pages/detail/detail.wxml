<!-- 离屏 canvas：只在转发前画分享卡用，移出屏幕而非 display:none（隐藏后取不到节点） -->
<canvas type="2d" id="share-canvas" class="share-canvas"></canvas>
<canvas type="2d" id="mvp-long-canvas" class="share-canvas"></canvas>

<view class="empty" wx:if="{{loadError}}">
  <view class="empty-title">打不开这场比赛</view>
  <view class="empty-desc">{{loadError}}</view>
</view>

<view class="page detail" wx:if="{{match}}">
  <view class="hero" style="background: linear-gradient(135deg, {{comp.accent}} 0%, {{comp.accent}}cc 100%)">
    <view class="sport-label"><image class="sport-icon" wx:if="{{comp.cat}}" src="/images/sport-{{comp.cat}}-white.png" mode="aspectFit"/><view class="hero-tag">{{comp.name}}</view></view>
    <view class="hero-comp">{{match._isTennis ? match._tournamentTitle : comp.full}}</view>
    <view class="hero-stage">{{match._isTennis ? match._roundNameRaw : match.stage}}</view>
  </view>

  <view class="score-card">
    <view class="score-time">
      <view class="score-clock">{{match.time}}</view>
      <view class="score-day">{{match._dayLabel}}</view>
    </view>

    <view class="score-line"></view>

    <view class="score-body">
      <view class="team" data-side="home" bindtap="onTeamTap" hover-class="team-hover">
        <view class="team-dot" style="background: {{match.home.color}}"></view>
        <view class="team-name {{match._homeWin ? 'win' : ''}} {{match._isTennis ? 'tennis-name' : ''}}">{{match.home.zhName}}<text class="tennis-seed" wx:if="{{match.home.seed}}">[{{match.home.seed}}]</text></view><text class="tennis-retired" wx:if="{{match.home.retired}}">退赛</text>
        <view class="team-score {{match._homeWin ? 'win' : ''}}" wx:if="{{match._hasScore}}">{{match.home.score}}</view>
      </view>
      <view class="vs">{{match._hasScore ? (comp.cat === 'tennis' ? '盘分' : '') : 'VS'}}</view>
      <view class="team" data-side="away" bindtap="onTeamTap" hover-class="team-hover">
        <view class="team-dot" style="background: {{match.away.color}}"></view>
        <view class="team-name {{match._awayWin ? 'win' : ''}} {{match._isTennis ? 'tennis-name' : ''}}">{{match.away.zhName}}<text class="tennis-seed" wx:if="{{match.away.seed}}">[{{match.away.seed}}]</text></view><text class="tennis-retired" wx:if="{{match.away.retired}}">退赛</text>
        <view class="team-score {{match._awayWin ? 'win' : ''}}" wx:if="{{match._hasScore}}">{{match.away.score}}</view>
      </view>
    </view>
  </view>

  <view class="tennis-event-links" wx:if="{{match._isTennis}}">
    <view data-tab="schedule" bindtap="goTournament">分站赛程 · 按球场查看 ›</view>
    <view data-tab="bracket" bindtap="goTournament">完整晋级图 ›</view>
  </view>

  <!-- 篮球分节比分：只有上游给了 linescores 才显示（足球没有分节） -->
  <view class="q-card" wx:if="{{detail.hasQuarters}}">
    <view class="q-row q-head">
      <view class="q-t">球队</view>
      <view class="q-n" wx:for="{{detail.quarters.cols}}" wx:for-item="c" wx:key="*this">{{c}}</view>
    </view>
    <view class="q-row" wx:for="{{detail.quarters.rows}}" wx:for-item="r" wx:key="side">
      <view class="q-t">{{r.side}}</view>
      <view class="q-n" wx:for="{{detail.quarters.cols}}" wx:for-item="c" wx:key="*this">{{r.scores[index]}}</view>
    </view>
  </view>

  <view class="q-card" wx:if="{{tennisSets}}">
    <view class="q-row q-head">
      <view class="q-t">选手</view>
      <view class="q-n" wx:for="{{tennisSets.cols}}" wx:for-item="c" wx:key="*this">{{c}}</view>
    </view>
    <view class="q-row" wx:for="{{tennisSets.rows}}" wx:for-item="r" wx:key="side">
      <view class="q-t">{{r.side}}<text class="tennis-seed" wx:if="{{r.seed}}">[{{r.seed}}]</text><text class="tennis-retired" wx:if="{{r.retired}}">退赛</text></view>
      <view class="q-n" wx:for="{{tennisSets.cols}}" wx:for-item="c" wx:key="*this">{{r.scores[index]}}</view>
    </view>
  </view>

  <view class="tennis-stats-card" wx:if="{{tennisStats}}">
    <view class="tennis-stats-title">单场技术统计</view>
    <view class="tennis-stats-tabs">
      <text wx:for="{{tennisStats.sections}}" wx:key="key" class="{{tennisStatsKey === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="onTennisStatsTab">{{item.label}}</text>
    </view>
    <view class="tennis-stat-row tennis-stat-head"><text>{{match.home.zhName}}</text><text>项目</text><text>{{match.away.zhName}}</text></view>
    <view class="tennis-stats-note" wx:if="{{tennisStatsDuration}}">{{tennisStatsKey === 0 ? '比赛耗时' : '本盘耗时'}} {{tennisStatsDuration}}</view>
    <view class="tennis-stat-row" wx:for="{{tennisStatsRows}}" wx:key="label"><text>{{item.home}}</text><text>{{item.label}}</text><text>{{item.away}}</text></view>
    <view class="tennis-stats-note">{{tennisStats.source}} · 同步于 {{tennisStats.updated}}。{{tennisStats.complete ? '' : '统计更新中。'}}— 表示来源未提供或无适用机会。</view>
  </view>
  <view class="retirement-note" wx:if="{{match._isRetirement}}">退赛场次保留退赛前的实际赢盘数和逐盘比分。</view>
  <view class="status-bar">
    <view class="status-pill status-{{match.status}}">{{match._statusLabel}}</view>
    <view class="status-hint" wx:if="{{match._statusHint}}">{{match._statusHint}}</view>
    <view class="status-badge" wx:if="{{match._bo}}">{{match._bo}}</view>
    <view class="status-badge ghost" wx:if="{{match._historical}}">历史战绩</view>
  </view>

  <view class="section">
    <view class="info">
      <view class="info-row" wx:for="{{rows}}" wx:key="label">
        <view class="info-label">{{item.label}}</view>
        <view class="info-value">{{item.value}}</view>
      </view>
    </view>
  </view>

  <!-- 赛前说明：未开赛时下面只有近况与交锋两块，得说清楚，否则像是没加载出来 -->
  <view class="pre-tip" wx:if="{{detail.isPre && detail.hasForm}}">
    <view class="pre-tip-title">赛前预览</view>
    <view class="pre-tip-desc">开赛后这里会换成实时事件与技术统计</view>
  </view>

  <!-- 🔴 赛后说明（2026-10-08 加）：超过 48 小时的比赛，事件 / 统计 / 阵容会被**主动裁掉**
       （包体积取舍，见 tools/match-detail.js 的 staleLineups）—— 这是设计好的，
       但以前只在源码注释里写了，用户看到的是「只剩比分卡、其他全没了」，
       第一反应是没加载出来或者 App 坏了。这里显式说一句。 -->
  <view class="pre-tip" wx:if="{{!match._isTennis && match.status === 'finished' && (!detail || !(detail.hasTimeline || detail.hasStats || detail.hasForm || detail.hasH2H || detail.hasBox || detail.hasKpl || detail.hasLol))}}">
    <view class="pre-tip-title">{{statsPending ? '比赛数据统计中，请稍后查阅。' : '赛后数据暂不可用'}}</view>
    <view class="pre-tip-desc" wx:if="{{!statsPending}}">比赛详情按保留窗口显示；阵容与球员统计仅保留约 48 小时，比分不受影响</view>
  </view>

  <view class="pre-tip" wx:if="{{match._isTennis && match.status !== 'upcoming' && !tennisStats}}">
    <view class="pre-tip-title">{{match.status === 'finished' ? (statsPending ? '比赛数据统计中，请稍后查阅。' : '技术统计暂不可用') : '技术统计待更新'}}</view>
  </view>

  <!-- ① 事件时间轴 -->
  <view class="section card" wx:if="{{detail.hasTimeline}}">
    <view class="sec-title">比赛事件</view>
    <view class="tl">
      <view class="tl-row {{item.goal ? 'is-goal' : ''}} {{item.key ? '' : 'is-minor'}}"
            wx:for="{{detail.shownEvents}}" wx:key="idx">
        <view class="tl-min">{{item.m}}</view>
        <view class="tl-dot {{item.side}}"></view>
        <view class="tl-body">
          <view class="tl-type">{{item.tLabel}}</view>
          <view class="tl-desc" wx:if="{{item.s}}">{{item.s}}</view>
        </view>
      </view>
    </view>
    <view class="tl-toggle" wx:if="{{detail.subCount}}" bindtap="onToggleSubs">
      {{detailAll ? '收起换人' : '展开换人（' + detail.subCount + '）'}}
    </view>
  </view>

  <!-- ② 技术统计 -->
  <view class="section card" wx:if="{{detail.hasStats}}">
    <view class="sec-title">技术统计</view>
    <view class="st-row" wx:for="{{detail.stats}}" wx:key="k">
      <view class="st-key">{{item.k}}</view>
      <view class="st-line">
        <view class="st-val home">{{item.h}}</view>
        <view class="st-bar">
          <view class="st-half l"><view class="st-fill h" style="width: {{item.hp}}%"></view></view>
          <view class="st-half r"><view class="st-fill a" style="width: {{item.ap}}%"></view></view>
        </view>
        <view class="st-val away">{{item.a}}</view>
      </view>
    </view>
  </view>

  <!-- ③ 首发阵容（只有足球有。未开赛上游不标首发、NBA 没有此数据、超出 48 小时窗口会被裁掉 → 整块隐藏） -->
  <view class="section card" wx:if="{{detail.hasLineups}}">
    <view class="sec-title">首发阵容</view>
    <view class="lu-block" wx:for="{{detail.lineups}}" wx:key="key">
      <view class="lu-side">{{item.side}}</view>
      <view class="lu-group" wx:for="{{item.groups}}" wx:for-item="g" wx:key="key">
        <view class="lu-pos">{{g.label}}</view>
        <view class="lu-rows">
          <view class="lu-p" wx:for="{{g.rows}}" wx:for-item="p" wx:key="n">
            <view class="lu-no">{{p.j}}</view>
            <view class="lu-nm">{{p.n}}</view>
          </view>
        </view>
      </view>
      <view class="lu-bgroup" wx:if="{{item.hasBench}}">
        <view class="lu-pos">替补席</view>
        <view class="lu-bench">
          <text class="lu-bn" wx:for="{{item.bench}}" wx:for-item="p" wx:key="n">{{p.j}} {{p.n}}</text>
        </view>
      </view>
    </view>
    <view class="foot-note tight">阵容为赛前公布的名单，临场调整请以官方发布为准。</view>
  </view>

  <!-- ③b 单场球员数据（只有篮球有。足球的 boxscore.players 是空的；未开赛上游不给；超出 48 小时窗口会被裁掉 → 整块隐藏） -->
  <view class="section card" wx:if="{{detail.hasBox}}">
    <view class="sec-title">球员数据</view>
    <view class="bx-block" wx:for="{{detail.box.blocks}}" wx:for-item="b" wx:key="key">
      <view class="bx-side">{{b.side}}</view>
      <view class="bx-row bx-head">
        <view class="bx-nm">球员</view>
        <view class="bx-c" wx:for="{{detail.box.cols}}" wx:for-item="c" wx:key="*this">{{c}}</view>
      </view>
      <view class="bx-row" wx:for="{{b.rows}}" wx:for-item="p" wx:key="i">
        <view class="bx-nm">
          <text class="bx-no" wx:if="{{p.j}}">{{p.j}}</text>
          <text class="bx-name {{p.st ? 'st' : ''}}">{{p.n}}</text>
        </view>
        <view class="bx-c" wx:for="{{p.cells}}" wx:for-item="v" wx:key="*this">{{v}}</view>
      </view>
    </view>
    <view class="foot-note tight">数据来自 ESPN 官方技术统计，未出场球员不列入。</view>
  </view>

  <!-- ③c KPL 单局战报（只有 KPL 有）：局 tab 一次只看一局，局内两队按位置对位。
       布局对齐 KPL 官方 App 的「数据」页（10-06 用户参考图），没有击杀/经济数据就不硬造。 -->
  <view class="section card" wx:if="{{detail.hasKpl}}">
    <view class="sec-title">单局战报</view>
    <scroll-view class="kp-tabs" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
      <view
        class="kp-tab {{detail.kpl.active === idx ? 'on' : ''}}"
        wx:for="{{detail.kpl.rounds}}"
        wx:for-item="r"
        wx:for-index="idx"
        wx:key="idx"
        data-idx="{{idx}}"
        bindtap="onKplRound"
      >第 {{r.n}} 局</view>
    </scroll-view>

    <block wx:for="{{detail.kpl.rounds}}" wx:for-item="r" wx:for-index="idx" wx:key="idx">
      <view wx:if="{{detail.kpl.active === idx}}" class="kp-round">
        <!-- 局条：胜方一侧高亮 + 到这局为止的累计局分（从逐局胜方推出，不是击杀比分） -->
        <view class="kp-bar">
          <text class="kp-side-name {{r.s === 'h' ? 'win' : 'dim'}}">{{detail.kpl.homeLabel}}<text wx:if="{{r.s === 'h'}}" class="kp-winner-tag">胜方</text></text>
          <text class="kp-score">{{r.hs}} : {{r.as}}</text>
          <text class="kp-side-name rt {{r.s === 'a' ? 'win' : 'dim'}}">{{detail.kpl.awayLabel}}<text wx:if="{{r.s === 'a'}}" class="kp-winner-tag">胜方</text></text>
        </view>

        <!-- 对位：左右两队各 5 人，按位置对齐；胜方一侧头像带描边 -->
        <view class="kp-row" wx:for="{{r.rows}}" wx:for-item="row" wx:for-index="pi" wx:key="pi">
          <view class="kp-cell" wx:if="{{row.l}}">
            <image class="kp-hero {{r.s === 'h' ? 'win' : ''}}" src="{{row.l.icon}}" mode="aspectFill" lazy-load="{{true}}" />
            <view class="kp-meta">
              <view class="kp-hero-name">{{row.l.hero}}</view>
              <view class="kp-sub">{{row.l.n}}<text wx:if="{{row.l.real}}" class="kp-real">（{{row.l.real}}）</text></view>
            </view>
          </view>
          <view class="kp-pos" wx:if="{{!row.l}}">—</view>
          <view class="kp-mid">{{row.pos}}</view>
          <view class="kp-cell right" wx:if="{{row.r}}">
            <view class="kp-meta rt">
              <view class="kp-hero-name">{{row.r.hero}}</view>
              <view class="kp-sub rt">{{row.r.n}}<text wx:if="{{row.r.real}}" class="kp-real">（{{row.r.real}}）</text></view>
            </view>
            <image class="kp-hero {{r.s === 'a' ? 'win' : ''}}" src="{{row.r.icon}}" mode="aspectFill" lazy-load="{{true}}" />
          </view>
          <view class="kp-pos" wx:if="{{!row.r}}">—</view>
        </view>
      </view>
    </block>

    <view class="foot-note tight">英雄与选手信息来自 KPL 官方赛报；左右两侧按对抗路 / 中路 / 发育路 / 打野 / 游走对位。</view>
  </view>

  <view class="section card" wx:if="{{detail.hasLol}}">
    <view class="sec-title">LOL 单局数据</view>
    <scroll-view class="kp-tabs" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="kp-tab {{detail.lol.active === idx ? 'on' : ''}}"
        wx:for="{{detail.lol.rounds}}" wx:for-item="r" wx:for-index="idx" wx:key="id"
        data-idx="{{idx}}" bindtap="onLolRound">第 {{r.n}} 局</view>
    </scroll-view>
    <block wx:for="{{detail.lol.rounds}}" wx:for-item="r" wx:for-index="ri" wx:key="id">
      <view wx:if="{{detail.lol.active === ri}}">
        <view class="lol-note {{r.complete ? '' : 'partial'}}">{{r.note}}</view>
        <view class="lol-result" wx:if="{{detail.lol.showResult}}">{{r.resultNote}}</view>
        <view class="lol-team-pair">
          <view class="lol-team-summary" wx:for="{{r.teams}}" wx:for-item="t" wx:for-index="ti" wx:key="label">
          <view class="lol-team-name">{{t.label}} <text class="lol-result-tag {{t.result === '胜' ? 'won' : ''}}" wx:if="{{t.result}}">{{t.result}}</text> <text class="lol-side">{{t.side}}</text></view>
          <view class="lol-totals">击杀 {{t.kills}} · 经济 {{t.gold}}<view>推塔 {{t.towers}} · 小龙 {{t.dragons}} · 大龙 {{t.barons}}</view></view>
          </view>
        </view>
        <view class="lol-duel" wx:for="{{r.rows}}" wx:for-item="duel" wx:for-index="di" wx:key="key">
          <view class="lol-duel-identities">
            <block wx:for="{{duel.players}}" wx:for-item="p" wx:for-index="si">
              <view wx:if="{{si === 1}}" class="lol-duel-role">{{duel.label}}</view>
              <view class="lol-duel-player {{si === 1 ? 'away' : ''}}">
                <block wx:if="{{p}}">
                  <image wx:if="{{p.icon}}" class="lol-hero" src="{{p.icon}}" mode="aspectFill" lazy-load="{{true}}"
                    data-round="{{ri}}" data-row="{{di}}" data-side="{{si}}" binderror="onLolHeroError" />
                  <view wx:else class="lol-hero lol-hero-placeholder">—</view>
                  <view class="lol-copy"><view>{{p.name}}</view><view class="lol-champion">{{p.champion}}</view></view>
                </block>
                <view wx:else class="lol-missing">暂无选手数据</view>
              </view>
            </block>
          </view>
          <view class="lol-compare-stat"><text>{{duel.players[0] ? duel.players[0].kda : '—'}}</text><text class="lol-stat-label">K / D / A</text><text>{{duel.players[1] ? duel.players[1].kda : '—'}}</text></view>
          <view class="lol-compare-stat"><text>{{duel.players[0] ? duel.players[0].cs : '—'}}</text><text class="lol-stat-label">补刀</text><text>{{duel.players[1] ? duel.players[1].cs : '—'}}</text></view>
          <view class="lol-compare-stat"><text>{{duel.players[0] ? duel.players[0].gold : '—'}}</text><text class="lol-stat-label">经济</text><text>{{duel.players[1] ? duel.players[1].gold : '—'}}</text></view>
        </view>
      </view>
    </block>
  </view>

  <view class="section card" wx:if="{{detail.matchMvp.available}}">
    <view class="sec-title">{{detail.matchMvp.title}}</view>
    <view class="mvp-intro">每个账号仅能投 1 票，投出后不可更改。仅展示本场实际出场选手。</view>
    <view class="mvp-summary" bindtap="retryMatchMvpSummary">
      <view class="mvp-total-label" wx:if="{{detail.matchMvp.enabled}}">累计投票 <text class="mvp-total-number">{{detail.matchMvp.totalVotes}}</text> 票</view>
      <view class="mvp-total-label" wx:else>读取投票数据</view>
      <view class="mvp-leader">{{detail.matchMvp.leaderSummary}}</view>
    </view>
    <view class="mvp-team-head">
      <view class="mvp-role-head"></view>
      <view class="mvp-team-title">{{detail.matchMvp.homeLabel}}</view>
      <view class="mvp-team-title">{{detail.matchMvp.awayLabel}}</view>
    </view>
    <view class="mvp-matchup-row" wx:for="{{detail.matchMvp.positions}}" wx:for-item="position" wx:key="roleKey">
      <view class="mvp-role-label">{{position.label}}</view>
      <view class="mvp-side-list">
        <view class="mvp-candidate-compact {{item.isMine ? 'mine' : ''}} {{item.isShared ? 'shared' : ''}} {{detail.matchMvp.myVote ? 'locked' : ''}}"
          wx:for="{{position.home}}" wx:key="key" data-key="{{item.key}}" bindtap="onMatchMvpVote">
          <view class="mvp-candidate-top">
            <view class="mvp-candidate-name">{{item.name}}</view>
            <view class="mvp-vote-badge" wx:if="{{detail.matchMvp.enabled}}"><text class="mvp-vote-number">{{item.votes}}</text> 票</view>
          </view>
          <view class="match-mvp-stats"><text wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label">{{stat.label}} {{stat.value}}</text></view>
          <view class="mvp-champions" wx:if="{{item.championText}}">{{item.championText}}</view>
          <view class="mvp-action" wx:if="{{item.isMine}}">你已投出 MVP</view>
          <view class="mvp-action locked-text" wx:elif="{{detail.matchMvp.myVote}}">本场已投</view>
          <view class="mvp-action" wx:elif="{{item.isShared}}">好友分享的选择</view>
          <view class="mvp-action" wx:elif="{{matchMvpVoteBusy}}">正在记录…</view>
          <view class="mvp-action" wx:else>选 TA</view>
        </view>
        <view class="mvp-empty" wx:if="{{!position.home.length}}">该位置无出场球员</view>
      </view>
      <view class="mvp-side-list away">
        <view class="mvp-candidate-compact {{item.isMine ? 'mine' : ''}} {{item.isShared ? 'shared' : ''}} {{detail.matchMvp.myVote ? 'locked' : ''}}"
          wx:for="{{position.away}}" wx:key="key" data-key="{{item.key}}" bindtap="onMatchMvpVote">
          <view class="mvp-candidate-top">
            <view class="mvp-candidate-name">{{item.name}}</view>
            <view class="mvp-vote-badge" wx:if="{{detail.matchMvp.enabled}}"><text class="mvp-vote-number">{{item.votes}}</text> 票</view>
          </view>
          <view class="match-mvp-stats"><text wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label">{{stat.label}} {{stat.value}}</text></view>
          <view class="mvp-champions" wx:if="{{item.championText}}">{{item.championText}}</view>
          <view class="mvp-action" wx:if="{{item.isMine}}">你已投出 MVP</view>
          <view class="mvp-action locked-text" wx:elif="{{detail.matchMvp.myVote}}">本场已投</view>
          <view class="mvp-action" wx:elif="{{item.isShared}}">好友分享的选择</view>
          <view class="mvp-action" wx:elif="{{matchMvpVoteBusy}}">正在记录…</view>
          <view class="mvp-action" wx:else>选 TA</view>
        </view>
        <view class="mvp-empty" wx:if="{{!position.away.length}}">该位置无出场球员</view>
      </view>
    </view>
    <view class="btn-row mvp-share-actions" wx:if="{{detail.matchMvp.myVote}}">
      <button class="btn primary mvp-share-btn" open-type="share" data-kind="match-mvp" disabled="{{!matchMvpShareImage}}">分享我的 MVP 选择</button>
      <button class="btn primary mvp-share-btn" bindtap="generateMatchMvpPoster" loading="{{matchMvpPosterBusy}}" disabled="{{matchMvpPosterBusy}}">生成长图</button>
    </view>
    <view class="foot-note tight" wx:if="{{match.comp !== 'kpl'}}">{{detail.matchMvp.note}}</view>
  </view>

  <view class="section card" wx:if="{{detail.lolMvp.available && detail.lolMvp.enabled}}">
    <view class="sec-title">系列赛 MVP 投票</view>
    <view class="mvp-intro">每个账号仅能投 1 票，投出后不可更改。数据为完整系列赛各局累计。</view>
    <view class="mvp-summary">
      <view class="mvp-total-label">累计投票 <text class="mvp-total-number">{{detail.lolMvp.totalVotes}}</text> 票</view>
      <view class="mvp-leader">当前领先：{{detail.lolMvp.leaderSummary}}</view>
    </view>
    <view class="mvp-team-head">
      <view class="mvp-role-head"></view>
      <view class="mvp-team-title">{{detail.lolMvp.homeLabel}}</view>
      <view class="mvp-team-title">{{detail.lolMvp.awayLabel}}</view>
    </view>
    <view class="mvp-matchup-row" wx:for="{{detail.lolMvp.positions}}" wx:for-item="position" wx:for-index="positionIndex" wx:key="roleKey">
      <view class="mvp-role-label">{{position.label}}</view>
      <view class="mvp-side-list">
        <view class="mvp-candidate-compact {{item.isMine ? 'mine' : ''}} {{item.isShared ? 'shared' : ''}} {{detail.lolMvp.myVote ? 'locked' : ''}}"
          wx:for="{{position.home}}" wx:for-item="item" wx:for-index="candidateIndex" wx:key="key"
          data-key="{{item.key}}" bindtap="onLolMvpVote">
          <view class="mvp-candidate-top">
            <view class="mvp-candidate-name">{{item.name}}</view>
            <view class="mvp-vote-badge"><text class="mvp-vote-number">{{item.votes}}</text><text> 票</text></view>
          </view>
          <view class="mvp-champions">{{item.championText}}</view>
          <view class="mvp-stats">K/D/A {{item.k}}/{{item.d}}/{{item.a}}</view>
          <view class="mvp-stats">补刀 {{item.cs}} · 经济 {{item.gold}}</view>
          <view class="mvp-games">{{item.games}} 局</view>
          <view class="mvp-action" wx:if="{{item.isMine}}">你已投出 MVP</view>
          <view class="mvp-action locked-text" wx:elif="{{detail.lolMvp.myVote}}">本场已投</view>
          <view class="mvp-action" wx:elif="{{item.isShared}}">好友分享的选择</view>
          <view class="mvp-action" wx:elif="{{mvpVoteBusy}}">正在记录…</view>
          <view class="mvp-action" wx:else>选 TA</view>
        </view>
        <view class="mvp-empty" wx:if="{{!position.home.length}}">暂无完整数据</view>
      </view>
      <view class="mvp-side-list away">
        <view class="mvp-candidate-compact {{item.isMine ? 'mine' : ''}} {{item.isShared ? 'shared' : ''}} {{detail.lolMvp.myVote ? 'locked' : ''}}"
          wx:for="{{position.away}}" wx:for-item="item" wx:for-index="candidateIndex" wx:key="key"
          data-key="{{item.key}}" bindtap="onLolMvpVote">
          <view class="mvp-candidate-top">
            <view class="mvp-candidate-name">{{item.name}}</view>
            <view class="mvp-vote-badge"><text class="mvp-vote-number">{{item.votes}}</text><text> 票</text></view>
          </view>
          <view class="mvp-champions">{{item.championText}}</view>
          <view class="mvp-stats">K/D/A {{item.k}}/{{item.d}}/{{item.a}}</view>
          <view class="mvp-stats">补刀 {{item.cs}} · 经济 {{item.gold}}</view>
          <view class="mvp-games">{{item.games}} 局</view>
          <view class="mvp-action" wx:if="{{item.isMine}}">你已投出 MVP</view>
          <view class="mvp-action locked-text" wx:elif="{{detail.lolMvp.myVote}}">本场已投</view>
          <view class="mvp-action" wx:elif="{{item.isShared}}">好友分享的选择</view>
          <view class="mvp-action" wx:elif="{{mvpVoteBusy}}">正在记录…</view>
          <view class="mvp-action" wx:else>选 TA</view>
        </view>
        <view class="mvp-empty" wx:if="{{!position.away.length}}">暂无完整数据</view>
      </view>
    </view>
    <view class="btn-row mvp-share-actions" wx:if="{{detail.lolMvp.myVote}}">
      <button class="btn primary mvp-share-btn" open-type="share" data-kind="lol-mvp"
        disabled="{{!lolMvpShareImage}}">分享我的 MVP 选择</button>
      <button class="btn primary mvp-share-btn" bindtap="generateLolMvpPoster"
        loading="{{mvpPosterBusy}}" disabled="{{mvpPosterBusy}}">生成长图</button>
    </view>
  </view>

  <!-- ④ 双方近况 -->
  <view class="section card" wx:if="{{detail.hasForm}}">
    <view class="sec-title">双方近况</view>
    <view class="sec-sub">最近参加的 5 场正式比赛，可能跨赛季</view>
    <view class="form-block" wx:for="{{detail.formRows}}" wx:key="idx">
      <view class="form-side">{{item.side}}</view>
      <view class="form-item" wx:for="{{item.list}}" wx:for-item="g" wx:key="i">
        <view class="f-badge {{g.r}}">{{g.rText}}</view>
        <view class="f-at">{{g.at}}</view>
        <view class="f-opp">{{g.opp}}</view>
        <view class="f-sc">{{g.sc}}</view>
      </view>
    </view>
  </view>

  <!-- ⑤ 历史交锋 -->
  <view class="section card" wx:if="{{detail.hasH2H}}">
    <view class="sec-title">历史交锋</view>
    <view class="sec-sub" wx:if="{{detail.h2h.summary}}">{{detail.h2h.summary}}</view>
    <view class="h2h-row" wx:for="{{detail.h2h.list}}" wx:key="d">
      <view class="h2h-date">{{item.d}}</view>
      <view class="h2h-teams">
        <text class="{{item.hs > item.as ? 'win' : ''}}">{{item.ho}}</text>
        <text class="h2h-sc">{{item.hs}} - {{item.as}}</text>
        <text class="{{item.as > item.hs ? 'win' : ''}}">{{item.ao}}</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <view class="btn-row">
      <view class="btn primary {{isFav ? 'added' : ''}}" bindtap="onFavTap">
        {{isFav ? '已关注 · 点击取消' : '关注这场比赛'}}
      </view>
      <button class="btn primary share-btn" open-type="share">分享赛果</button>
    </view>
    <view class="match-notifications" wx:if="{{isFav && (match.status === 'upcoming' || match.status === 'live')}}">
      <view class="match-notifications-title">比赛通知</view>
      <view class="match-notifications-note">赛前1小时、15分钟提醒，每次授权发一条</view>
      <view class="notification-state-row" wx:if="{{canRequestPre15}}">
        <text>开赛前 15 分钟</text>
        <text class="notification-state {{notificationStates.pre15 ? 'ready' : ''}}">{{notificationStates.pre15 === 'sent' ? '已发送' : notificationStates.pre15 === 'sending' ? '发送中' : notificationStates.pre15 ? '已订阅' : '未设置'}}</text>
      </view>
      <view class="notification-state-row" wx:if="{{canRequestPre60}}">
        <text>开赛前 1 小时</text>
        <text class="notification-state {{notificationStates.pre60 ? 'ready' : ''}}">{{notificationStates.pre60 === 'sent' ? '已发送' : notificationStates.pre60 === 'sending' ? '发送中' : notificationStates.pre60 ? '已订阅' : '未设置'}}</text>
      </view>
      <view class="notification-state-row">
        <text>比赛结束赛果</text>
        <text class="notification-state {{notificationStates.result ? 'ready' : ''}}">{{notificationStates.result === 'sent' ? '已发送' : notificationStates.result === 'sending' ? '发送中' : notificationStates.result ? '已订阅' : '未设置'}}</text>
      </view>
      <view class="notification-action" wx:if="{{(match.status === 'upcoming' && ((canRequestPre15 && !notificationStates.pre15) || !notificationStates.result)) || (match.status === 'live' && !notificationStates.result)}}" bindtap="onNotificationTap">
        {{notificationBusy ? '处理中…' : match.status === 'live' ? '订阅比赛结束赛果通知' : '设置赛前15分钟 / 赛果通知'}}
      </view>
      <view class="notification-action secondary" wx:if="{{canRequestPre60 && !notificationStates.pre60}}" bindtap="onExtraPreReminderTap">
        {{notificationBusy ? '处理中…' : '加一轮：开赛前1小时提醒'}}
      </view>
    </view>
    <view class="btn ghost" bindtap="onCompTap">查看{{comp.name}}全部赛程</view>
    <view class="btn ghost" wx:if="{{hasStandings}}" bindtap="onStandingsTap">查看{{comp.name}}排行榜</view>
  </view>

  <view class="safe-bottom"></view>
</view>
