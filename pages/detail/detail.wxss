.detail {
  padding-bottom: 0;
}

.hero {
  position: relative;
  padding: 36rpx 40rpx 44rpx;
  color: #fff;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-tag {
  position: relative;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-comp {
  position: relative;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-stage {
  position: relative;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.score-card {
  display: flex;
  align-items: stretch;
  margin: -20rpx 24rpx 0;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.1);
}

.score-time {
  flex: none;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.score-clock {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.score-day {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.score-line {
  flex: none;
  width: 2rpx;
  margin: 6rpx 24rpx;
  background: var(--line);
}

.score-body {
  flex: 1;
  min-width: 0;
}

.team {
  display: flex;
  align-items: center;
  min-height: 68rpx;
}

/* 点队名可进球队详情页，给一个明确的按压反馈 */
.team-hover {
  opacity: 0.65;
}

.team-dot {
  flex: none;
  width: 12rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
}

.team-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-name.win {
  color: var(--text);
  font-weight: 800;
}

.team-abbr {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--bg);
  font-size: 22rpx;
  color: var(--muted);
}

.team-score {
  flex: none;
  min-width: 64rpx;
  text-align: right;
  font-size: 46rpx;
  font-weight: 600;
  color: var(--muted);
}

.team-score.win {
  color: var(--text);
  font-weight: 800;
}

.vs {
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  padding: 6rpx 0;
}

.status-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
}

.status-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f2f4f7;
  color: var(--sub);
}

.status-pill.status-live {
  background: #fdeceb;
  color: var(--live);
  font-weight: 700;
}

.status-pill.status-upcoming {
  background: var(--brand-soft);
  color: var(--brand);
}

.status-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.status-badge {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: #f2f4f7;
  color: var(--sub);
  font-size: 20rpx;
}

.status-badge.ghost {
  color: var(--muted);
}

.info {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
}

.info-row {
  display: flex;
  padding: 22rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex: none;
  width: 160rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
  text-align: right;
  word-break: break-all;
}

.actions {
  margin: 28rpx 24rpx 0;
}

/* 2026-09-30 用户定：关注按钮缩到一半，分享赛果占右半边，中间留 20rpx 缝 */
.btn-row {
  display: flex;
  align-items: stretch;
}
.btn-row .btn {
  flex: 1;
  width: auto;
  min-width: 0;
  /* view 与 button 的默认 line-height 不同，显式统一才能等高 */
  line-height: 40rpx;
}
/* 用 margin 而不是 gap：旧版 iOS WebView 的 flex gap 支持不稳定 */
.btn-row .btn + .btn {
  margin-left: 20rpx;
}

.btn {
  padding: 26rpx 0;
  margin-bottom: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.primary {
  background: var(--brand);
  color: #fff;
}

.btn.primary.added {
  background: #fff;
  color: var(--sub);
  border: 2rpx solid var(--line);
}

.btn.ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--line);
}

/* 页面内分享按钮（open-type=share）：重置微信 button 默认样式以套用 .btn 外观 */
.share-btn {
  width: 100%;
  margin: 0 0 20rpx;
  line-height: 1;
}
.share-btn::after {
  border: none;
}

/* 离屏 canvas：只用于转发前绘制分享卡，移出屏幕而不是 display:none */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
}

/* ---------- 比赛详情：事件时间轴 / 技术统计 / 双方近况 / 历史交锋 ---------- */
/* 这四个区块共用「section 管外边距 + card 管卡片底」的组合，与页面其他卡片保持一致 */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 26rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
}

.sec-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.sec-title::before {
  content: '';
  display: block;
  width: 8rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 4rpx;
  background: var(--brand);
}

.sec-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin: 8rpx 0 12rpx;
}

/* 事件时间轴 */
.tl-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.tl-row:last-child {
  border-bottom: 0;
}

.tl-min {
  flex: none;
  width: 96rpx;
  font-size: 24rpx;
  color: var(--muted);
  padding-top: 2rpx;
}

.tl-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  margin: 10rpx 16rpx 0 0;
  border-radius: 50%;
  background: var(--muted);
}

.tl-dot.home {
  background: var(--brand);
}

.tl-dot.away {
  /* 客队统一用红，与统计条一致 —— 原来两个蓝点分不出主客 */
  background: #d93b3b;
}

.tl-body {
  flex: 1;
  min-width: 0;
}

.tl-type {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

.tl-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.tl-row.is-goal .tl-type {
  color: var(--live);
}

.tl-row.is-minor .tl-type {
  font-weight: 400;
  color: var(--muted);
}

.tl-toggle {
  margin-top: 12rpx;
  padding: 10rpx 0;
  font-size: 25rpx;
  color: var(--brand);
  text-align: center;
}

/* 技术统计 */
.st-row {
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.st-row:last-child {
  border-bottom: 0;
}

.st-key {
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
  text-align: center;
}

.st-line {
  display: flex;
  align-items: center;
}

.st-val {
  flex: none;
  width: 110rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.st-val.home {
  color: var(--brand);
}

.st-val.away {
  color: #d93b3b;
  text-align: right;
}

/* 主客双色对比条：从中间往两边长，大值的那边占满 —— 单色连成一条分不清主客 */
.st-bar {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 12rpx;
}

.st-half {
  flex: 1;
  height: 100%;
  background: var(--line);
  overflow: hidden;
}

.st-half.l {
  display: flex;
  justify-content: flex-end;
  border-radius: 6rpx 0 0 6rpx;
}

.st-half.r {
  border-radius: 0 6rpx 6rpx 0;
}

.st-fill {
  height: 100%;
}

.st-fill.h {
  background: var(--brand);
}

.st-fill.a {
  background: #d93b3b;
}

/* 首发阵容：按「门将 / 后卫 / 中场 / 前锋」分组，每组两列网格；替补席用小字一行排开 */
.lu-block {
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.lu-block:last-of-type {
  border-bottom: 0;
}

.lu-side {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.lu-pos {
  margin: 8rpx 0 2rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.lu-rows {
  display: flex;
  flex-wrap: wrap;
}

.lu-p {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 7rpx 0;
  font-size: 24rpx;
  color: var(--text);
}

.lu-no {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 21rpx;
  font-weight: 500;
  text-align: center;
  line-height: 46rpx;
}

.lu-nm {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lu-bgroup {
  margin-top: 8rpx;
}

.lu-bench {
  display: flex;
  flex-wrap: wrap;
}

.lu-bn {
  width: 50%;
  padding: 5rpx 0;
  font-size: 22rpx;
  color: var(--sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 篮球分节比分：球队名一列 + 每节一列，数字右对齐 */
.q-card {
  margin: 24rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: var(--border-radius-lg, 12rpx);
  background: var(--bg-card, #fff);
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.q-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: var(--text);
}

.q-head {
  color: var(--muted);
  font-size: 21rpx;
}

.q-t {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.q-n {
  flex: none;
  width: 76rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 单场球员数据（篮球）：一行一名球员，右侧 6 列数字右对齐 */
.bx-block {
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.bx-block:last-of-type {
  border-bottom: 0;
}

.bx-side {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.bx-row {
  display: flex;
  align-items: center;
  padding: 7rpx 0;
  font-size: 22rpx;
  color: var(--text);
}

.bx-head {
  padding-bottom: 4rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.bx-nm {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  overflow: hidden;
  white-space: nowrap;
}

.bx-no {
  flex: none;
  min-width: 32rpx;
  margin-right: 8rpx;
  color: var(--brand);
  font-size: 20rpx;
}

.bx-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bx-name.st {
  font-weight: 500;
}

.bx-c {
  flex: none;
  width: 78rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 双方近况 */
.form-block {
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.form-block:last-child {
  border-bottom: 0;
}

.form-side {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: var(--sub);
}

.f-badge {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  line-height: 40rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  text-align: center;
  background: var(--muted);
}

.f-badge.W {
  background: #d93b3b;
}

.f-badge.L {
  background: #6b7a90;
}

.f-at {
  flex: none;
  width: 44rpx;
  color: var(--muted);
}

.f-opp {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--text);
}

.f-sc {
  flex: none;
  color: var(--sub);
}

/* 历史交锋 */
.h2h-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 25rpx;
}

.h2h-row:last-of-type {
  border-bottom: 0;
}

.h2h-date {
  flex: none;
  width: 168rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.h2h-teams {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
}

.h2h-teams text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.h2h-teams .win {
  font-weight: 500;
}

.h2h-sc {
  flex: none;
  margin: 0 14rpx;
  color: var(--muted);
}

/* 赛前预览提示 */
.pre-tip {
  margin: 0 24rpx 20rpx;
  padding: 20rpx 24rpx;
  background: var(--brand-soft);
  border-radius: 16rpx;
}

.pre-tip-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--brand);
}

.pre-tip-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
}
