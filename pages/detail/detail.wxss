.detail {
  padding-bottom: 0;
}

.hero {
  position: relative;
  padding: 36rpx 40rpx 44rpx;
  color: #fff;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  overflow: hidden;
}

.hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -70rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.hero-tag {
  position: relative;
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 600;
}

.hero-comp {
  position: relative;
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-stage {
  position: relative;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.score-card {
  display: flex;
  align-items: stretch;
  margin: -20rpx 24rpx 0;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, 0.1);
}

.score-time {
  flex: none;
  width: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.score-clock {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.score-day {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.score-line {
  flex: none;
  width: 2rpx;
  margin: 6rpx 24rpx;
  background: var(--line);
}

.score-body {
  flex: 1;
  min-width: 0;
}

.team {
  display: flex;
  align-items: center;
  min-height: 68rpx;
}

.team-dot {
  flex: none;
  width: 12rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
}

.team-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-name.win {
  color: var(--text);
  font-weight: 800;
}

.team-abbr {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--bg);
  font-size: 22rpx;
  color: var(--muted);
}

.team-score {
  flex: none;
  min-width: 64rpx;
  text-align: right;
  font-size: 46rpx;
  font-weight: 600;
  color: var(--muted);
}

.team-score.win {
  color: var(--text);
  font-weight: 800;
}

.vs {
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
  padding: 6rpx 0;
}

.status-bar {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
}

.status-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #f2f4f7;
  color: var(--sub);
}

.status-pill.status-live {
  background: #fdeceb;
  color: var(--live);
  font-weight: 700;
}

.status-pill.status-upcoming {
  background: var(--brand-soft);
  color: var(--brand);
}

.status-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--sub);
}

.status-badge {
  margin-left: auto;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: #f2f4f7;
  color: var(--sub);
  font-size: 20rpx;
}

.status-badge.ghost {
  color: var(--muted);
}

.info {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
}

.info-row {
  display: flex;
  padding: 22rpx 28rpx;
  border-bottom: 2rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex: none;
  width: 160rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
  text-align: right;
  word-break: break-all;
}

.actions {
  margin: 28rpx 24rpx 0;
}

.btn {
  padding: 26rpx 0;
  margin-bottom: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.primary {
  background: var(--brand);
  color: #fff;
}

.btn.primary.added {
  background: #fff;
  color: var(--sub);
  border: 2rpx solid var(--line);
}

.btn.ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--line);
}

/* 页面内分享按钮（open-type=share）：重置微信 button 默认样式以套用 .btn 外观 */
.share-btn {
  width: 100%;
  margin: 0 0 20rpx;
  line-height: 1;
}
.share-btn::after {
  border: none;
}

/* 离屏 canvas：只用于转发前绘制分享卡，移出屏幕而不是 display:none */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
}
