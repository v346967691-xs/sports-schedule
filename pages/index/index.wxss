.worlds-entry { margin: 20rpx 24rpx; padding: 26rpx; border-radius: 20rpx; background: #14235c; color: #fff; border-bottom: 4rpx solid #b99433; }
.worlds-entry-title { font-size: 30rpx; font-weight: 700; }
.worlds-entry-sub { margin-top: 12rpx; color: #e6e7eb; font-size: 23rpx; line-height: 1.6; }
.date-strip-wrap {
  margin: 0 0 4rpx;
  white-space: nowrap;
}

.date-strip {
  display: flex;
  padding: 0 4rpx;
}

.date-strip::-webkit-scrollbar,
.chip-row::-webkit-scrollbar {
  display: none;
}

.mt {
  margin-top: 14rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 25rpx;
}

/* ---------- 搜索入口 ---------- */
.search-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 18rpx 18rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.04);
}

.search-entry-hover {
  background: #f7f8fb;
}

.se-ph {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.se-go {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 25rpx;
  font-weight: 600;
}

/* ---------- 首页快报头图区 ---------- */
.brief-entry {
  position: relative;
  min-height: 288rpx;
  padding: 36rpx 32rpx 38rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(135deg, #14235c 0%, #26377e 65%, #354895 100%);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  color: #fff;
}

.brief-entry::after {
  content: '';
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  top: -125rpx;
  right: -70rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(225, 199, 126, 0.2);
  background: rgba(255, 255, 255, 0.035);
  pointer-events: none;
}

.brief-entry-hover {
  opacity: 0.94;
}

.be-head {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.be-kicker {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.be-when {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #e1c77e;
}

.be-title {
  position: relative;
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #fff;
  overflow-wrap: break-word;
}

.be-link {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.be-link text {
  font-size: 30rpx;
  color: #e1c77e;
}

/* 数据陈旧警告：定时任务停了（如电脑关机）时提示用户比分可能不是最新的 */
.stale-tip {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #fff1f0;
  color: #b42318;
  font-size: 23rpx;
  line-height: 1.6;
  font-weight: 600;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.entry {
  position: relative;
  width: calc(50% - 10rpx);
  margin-bottom: 20rpx;
  padding: 24rpx 24rpx 26rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
  overflow: hidden;
  box-sizing: border-box;
}

.entry-hover {
  transform: scale(0.985);
}

.entry-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.entry-name {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.entry-count {
  font-size: 20rpx;
  color: var(--muted);
}

.entry-summary {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--sub);
  line-height: 1.6;
  min-height: 72rpx;
}

.entry-summary.is-dim {
  color: var(--muted);
}

.entry-rank {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--line);
}

.entry-rank-text {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: var(--sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.entry-rank-go {
  flex: none;
  margin-left: 12rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--brand);
}

.entry-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

/* 关注球队区块里「最近赛果 / 接下来的比赛」的小标题（与我的页保持一致） */
.section-sub {
  margin: 30rpx 0 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--sub);
}
