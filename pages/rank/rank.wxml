<!-- 离屏 canvas：只在转发前画分享卡用，移出屏幕而非 display:none（隐藏后取不到节点） -->
<canvas type="2d" id="share-canvas" class="share-canvas"></canvas>

<view class="page rank">
  <!-- 赛事标签区：这里横滑只是挪动标签本身，不切换下方内容；要切换必须点击 -->
  <scroll-view
    class="chip-bar"
    scroll-x
    enable-flex
    scroll-into-view="chip-{{activeComp}}"
    scroll-with-animation
  >
    <view class="chip-row">
      <view
        wx:for="{{comps}}"
        wx:key="key"
        id="chip-{{item.key}}"
        class="chip {{item.key === activeComp ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCompTap"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!--
    档位分段控件：档位**按赛事大类给不同的集合**（2026-10-06 改）
      足球 = 积分榜 / 射手榜 / 助攻榜
      篮球 = 积分榜 + 得分榜 / 篮板榜 / 助攻榜 / 抢断榜 / 盖帽榜
      电竞 = 积分榜（KPL 多一个选手榜；全球总决赛多一个瑞士轮战绩）
    ⚠️ 拿不到内容的档位**直接不渲染**，不再置灰占位 —— 与「空赛事入口隐藏」同一约定。
    ⚠️ 只剩一档时整条隐藏（一条只有一个按钮的分段控件没有意义）。
  -->
  <view class="tier-bar" wx:if="{{tiers.length > 1}}">
    <view
      wx:for="{{tiers}}"
      wx:key="key"
      class="tier {{item.key === tier ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTierTap"
    >{{item.label}}</view>
  </view>

  <!-- 内容区：左右横滑立刻换赛事，同时把顶部标签锚定过去 -->
  <swiper
    wx:if="{{slides.length}}"
    class="body"
    current="{{swiperIndex}}"
    bindchange="onSwiperChange"
    duration="240"
  >
    <swiper-item wx:for="{{slides}}" wx:key="key">
      <scroll-view class="slide-scroll" scroll-y scroll-top="{{item.scrollTop}}">
        <block wx:if="{{item.visible}}">
          <!-- 积分榜档（tierKind = standings） -->
          <block wx:if="{{tierKind === 'standings'}}">
            <view class="meta" wx:if="{{item.totalTeams}}">
              <text class="meta-main">{{item.name}} · {{item.totalTeams}} 支球队</text>
              <text class="meta-sub" wx:if="{{updatedAt}}">更新于 {{updatedAt}}{{source ? '（' + source + '）' : ''}}</text>
            </view>
            <view class="season-note" wx:if="{{item.season}}">{{item.season}}</view>

            <view class="empty" wx:if="{{item.empty}}">
              <view class="empty-title">该赛事暂无{{tierLabel}}</view>
              <view class="empty-desc">杯赛和中国国字号本来就没有排名，换一个赛事看看。</view>
            </view>

            <block wx:for="{{item.groups}}" wx:key="name" wx:for-item="group">
              <view class="group-head" wx:if="{{group.name}}">
                <view class="group-line"></view>
                <view class="group-name">{{group.name}}</view>
                <view class="group-line"></view>
              </view>

              <view class="table card">
                <view class="tr th">
                  <view class="th-pos">#</view>
                  <view class="th-team">球队</view>
                  <view
                    wx:for="{{item.columns}}"
                    wx:for-item="col"
                    wx:for-index="ci"
                    wx:key="key"
                    class="td num {{col.strong ? 'strong' : ''}}"
                  >{{col.label}}</view>
                </view>

                <view
                  wx:for="{{group.rows}}"
                  wx:for-item="row"
                  wx:key="id"
                  class="tr {{row.zoneBg ? 'zoned' : ''}}"
                  style="background: {{row.zoneBg}};"
                  data-id="{{row.id}}"
                  bindtap="onRowTap"
                  hover-class="tr-hover"
                >
                  <view class="td-pos">
                    <text class="pos-num">{{row.pos}}</text>
                  </view>
                  <view class="td-team">
                    <view class="team-name">{{row.name}}</view>
                  </view>
                  <view
                    wx:for="{{row.cells}}"
                    wx:for-item="cell"
                    wx:for-index="ci"
                    class="td num {{item.columns[ci].strong ? 'strong' : ''}}"
                  >{{cell}}</view>

                  <!-- 区块标签：只画在色带第一行，悬在行顶部与上一行的交界处 -->
                  <view wx:if="{{row.zoneFirst}}" class="zone-chip" style="background: {{row.zoneColor}};">
                    {{row.zoneLabel}}
                  </view>
                </view>
              </view>
            </block>

            <view class="legend" wx:if="{{item.legend.length}}">
              <block wx:for="{{item.legend}}" wx:key="label">
                <view class="legend-item" wx:if="{{item.label}}">
                  <view class="legend-dot" style="background: {{item.color}}"></view>
                  <text>{{item.label}}</text>
                </view>
              </block>
            </view>

            <view class="foot-note">
              分区色带只标联赛名次能确定的欧战席位，不含杯赛冠军名额与欧战表现名额；降级与欧国联升降级按官方赛制标注。
              足球按积分排序，篮球看胜率 —— 两类运动的规则本来就不一样。
              电竞榜由已结束的官方赛果实时汇总，赛季刚开始时可能还没生成。
            </view>
          </block>

          <!-- 射手榜 / 助攻榜档（足球，tierKind = scorer） -->
          <block wx:elif="{{tierKind === 'scorer'}}">
            <view class="meta" wx:if="{{item.rankRows.length}}">
              <text class="meta-main">{{item.name}} · {{tier === 'goals' ? '射手榜' : '助攻榜'}} 前 {{item.rankRows.length}} 名</text>
              <text class="meta-sub" wx:if="{{updatedAt}}">更新于 {{updatedAt}}{{source ? '（' + source + '）' : ''}}</text>
            </view>
            <view class="season-note" wx:if="{{item.season}}">{{item.season}}</view>

            <view class="empty" wx:if="{{!item.rankRows.length}}">
              <view class="empty-title">该赛事暂无{{tier === 'goals' ? '射手榜' : '助攻榜'}}</view>
              <view class="empty-desc">上游只提供部分赛事的球员榜，杯赛和国字号通常没有。</view>
            </view>

            <view class="table card scorer" wx:if="{{item.rankRows.length}}">
              <view class="tr th">
                <view class="th-pos">#</view>
                <view class="th-player">球员</view>
                <view class="th-val">{{tier === 'goals' ? '进球' : '助攻'}}</view>
                <view class="th-played">场次</view>
              </view>

              <view
                wx:for="{{item.rankRows}}"
                wx:for-item="row"
                wx:key="id"
                class="tr"
                data-id="{{row.teamId}}"
                bindtap="onRowTap"
                hover-class="tr-hover"
              >
                <view class="td-pos">
                  <text class="pos-num">{{row.pos}}</text>
                </view>
                <view class="td-player">
                  <!-- 中文名优先，未收录回落英文短名 —— 中英混排是预期内的正常状态 -->
                  <view class="player-name">
                    <text>{{row.name}}</text>
                    <text class="player-en" wx:if="{{row.hasZh}}">{{row.en}}</text>
                  </view>
                  <view class="player-team" wx:if="{{row.team}}">{{row.team}}</view>
                </view>
                <view class="td-val">{{row.value}}</view>
                <view class="td-played">{{row.played || '—'}}</view>
              </view>
            </view>

            <view class="foot-note">
              榜单由上游官方统计实时同步，只列各赛事前 {{item.rankRows.length}} 名。
              球员中文名来自自建词典，尚未收录的球员显示英文原名 —— 中英混排是正常现象。
              点一行可查看该球员所属球队的详情。
            </view>
          </block>

          <!-- 篮球数据榜档：得分 / 篮板 / 助攻 / 抢断 / 盖帽（tierKind = leader） -->
          <block wx:elif="{{tierKind === 'leader'}}">
            <view class="meta" wx:if="{{item.rankRows.length}}">
              <text class="meta-main">{{item.name}} · {{tierLabel}} 前 {{item.rankRows.length}} 名</text>
              <text class="meta-sub" wx:if="{{updatedAt}}">更新于 {{updatedAt}}{{source ? '（' + source + '）' : ''}}</text>
            </view>
            <view class="season-note" wx:if="{{item.season}}">{{item.season}}</view>

            <view class="empty" wx:if="{{!item.rankRows.length}}">
              <view class="empty-title">该赛事暂无{{tierLabel}}</view>
              <view class="empty-desc">赛季还没开打时上游不出数据榜，可以看看别的档位。</view>
            </view>

            <view class="table card scorer leader" wx:if="{{item.rankRows.length}}">
              <view class="tr th">
                <view class="th-pos">#</view>
                <view class="th-player">球员</view>
                <view class="th-val">场均</view>
              </view>

              <!-- 篮球榜不带球队信息，也没有对应的球员详情页 → 整行不可点 -->
              <view
                wx:for="{{item.rankRows}}"
                wx:for-item="row"
                wx:key="id"
                class="tr"
              >
                <view class="td-pos">
                  <text class="pos-num">{{row.pos}}</text>
                </view>
                <view class="td-player">
                  <!-- 中文名优先，未收录回落英文短名 —— 中英混排是预期内的正常状态 -->
                  <view class="player-name">
                    <text>{{row.name}}</text>
                    <text class="player-en" wx:if="{{row.hasZh}}">{{row.en}}</text>
                  </view>
                </view>
                <view class="td-val">{{row.value}}</view>
              </view>
            </view>

            <view class="foot-note">
              {{tierLabel}}取上游官方统计的前 {{item.rankRows.length}} 名，数值为场均，按官方排序原样呈现、不重排。
              赛季刚开始时可能还没生成，此时该档不会出现。
              球员中文名来自自建词典，尚未收录的显示英文原名 —— 中英混排是正常现象。
            </view>
          </block>

          <!-- KPL 选手数据榜档：官方 9 张榜，每张 Top5 -->
          <block wx:elif="{{tierKind === 'players'}}">
            <view class="meta" wx:if="{{item.boards.length}}">
              <text class="meta-main">{{item.name}} · 选手数据榜</text>
              <text class="meta-sub" wx:if="{{updatedAt}}">更新于 {{updatedAt}}{{source ? '（' + source + '）' : ''}}</text>
            </view>
            <view class="season-note" wx:if="{{item.season}}">{{item.season}}</view>

            <view class="empty" wx:if="{{!item.boards.length}}">
              <view class="empty-title">该赛事暂无选手数据榜</view>
              <view class="empty-desc">目前只有 KPL 提供选手维度的数据榜，其他赛事换一档看看。</view>
            </view>

            <view class="kpr-board card" wx:for="{{item.boards}}" wx:for-item="board" wx:key="key">
              <view class="kpr-title">{{board.name}}</view>
              <view
                wx:for="{{board.rows}}"
                wx:for-item="row"
                wx:key="name"
                class="kpr-row"
              >
                <view class="kpr-rank {{row.rank <= 3 ? 'top' : ''}}">{{row.rank}}</view>
                <view class="kpr-avatar">
                  <image class="kpr-img" src="{{row.avatar}}" mode="aspectFill"></image>
                </view>
                <view class="kpr-name">{{row.name}}</view>
                <view class="kpr-num">{{row.num}}</view>
              </view>
            </view>

            <view class="foot-note">
              数据来自 KPL 官方数据榜（每张取前 5），官方结算有延迟时会按滞后状态显示。
              数值保留官方原始单位，不做换算。
            </view>
          </block>

          <!-- 瑞士轮战绩档（tierKind = swiss）：按官方阶段战绩分组，不排名次 -->
          <block wx:elif="{{tierKind === 'swiss'}}">
            <view class="meta" wx:if="{{item.swissTeams}}">
              <text class="meta-main">{{item.name}} · 瑞士轮 {{item.swissTeams}} 支队伍</text>
              <text class="meta-sub" wx:if="{{updatedAt}}">更新于 {{updatedAt}}{{source ? '（' + source + '）' : ''}}</text>
            </view>

            <view class="empty" wx:if="{{!item.swiss.length}}">
              <view class="empty-title">该赛事暂无瑞士轮战绩</view>
              <view class="empty-desc">赛事开打后才会生成，赛程页可以看具体对阵。</view>
            </view>

            <!--
              ⚠️ 只有战绩分组，**没有名次列** —— 同战绩内官方本来就不排序（看小分/抽签），
                 自己编一个 1..16 的名次就是造假。谁晋级由战绩本身说话。
            -->
            <view class="swiss-card card" wx:for="{{item.swiss}}" wx:for-item="g" wx:key="key">
              <view class="swiss-side">
                <view class="swiss-record">{{g.key}}</view>
                <view class="swiss-count">{{g.teams.length}} 队</view>
              </view>
              <view class="swiss-teams">
                <view class="swiss-team" wx:for="{{g.teams}}" wx:for-item="t" wx:key="id">
                  <view class="swiss-dot" style="background: {{t.color}}"></view>
                  <text class="swiss-name">{{t.name}}</text>
                </view>
              </view>
            </view>

            <view class="foot-note">
              战绩取自上游官方给出的阶段战绩，不按比分自行累加 —— 赛事进行中显示当前战绩，打完后即为最终战绩。
              同战绩内官方不排名次，所以这里只按战绩分组、不显示名次。
            </view>
          </block>

          <view class="safe-bottom"></view>
        </block>
      </scroll-view>
    </swiper-item>
  </swiper>

  <view class="empty" wx:if="{{emptyReason}}">
    <view class="empty-title">没有可展示的榜单</view>
    <view class="empty-desc">
      {{emptyReason}}
      <block wx:if="{{comps.length}}">
        换一个有榜单的赛事看看，杯赛和中国国字号本来就没有排名。
      </block>
    </view>
    <view class="empty-btn" bindtap="goSchedule">去看赛程</view>
  </view>
</view>
