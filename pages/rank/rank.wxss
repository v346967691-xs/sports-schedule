/* ---------- 顶部标签区 + 横滑内容区 = 两个独立操作区 ----------
   页面本身不竖滚：标签条固定在顶部，swiper 吃掉剩余高度，每个赛事一屏、
   各自竖滚。这样横滑切赛事时看到的是新榜的第 1 名，不会停在上一屏的位置。
   ⚠️ swiper 用 flex:1 撑满（flex-basis:0 会盖掉它默认的 150px 高度），
      别改成 height:100%（会把标签条顶出屏幕）。 */
.page.rank {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 0;
  overflow: hidden;
}

.chip-bar {
  flex: none;
  white-space: nowrap;
  padding: 20rpx 0 18rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}

.body {
  flex: 1;
  min-height: 0;
}

.slide-scroll {
  height: 100%;
}

.chip-bar .chip {
  background: var(--bg);
}

.chip-bar .chip:first-child {
  margin-left: 24rpx;
}

.chip-bar .chip:last-child {
  margin-right: 24rpx;
}

/* ------------------------------------------------------------ 档位分段控件
   积分榜 / 射手榜 / 助攻榜。不可用的档位置灰且点了不响应。
   ⚠️ 选中态必须写成 `.tier-bar .tier.active`（0-3-0），
      只写 `.tier.active`（0-2-0）压不住上面的 `.tier-bar .tier` —— 与 chip 同一个权重坑。 */
.tier-bar {
  flex: none;
  display: flex;
  padding: 4rpx 24rpx 16rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}

.tier-bar .tier {
  flex: 1;
  margin: 0 6rpx;
  padding: 12rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: var(--sub);
  background: var(--bg);
  border-radius: 10rpx;
  transition: all 0.15s;
}

.tier-bar .tier.active {
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}

.tier-bar .tier.disabled {
  color: var(--muted);
  opacity: 0.4;
}

/* ------------------------------------------------------------ 球员榜表格
   列：# + 球员（队名折行在第二行）+ 数字 + 场次。
   球员列占满剩余宽度：750 - 48(外边距) - 32(内边距) - 52 - 96 - 88 = 434rpx，
   够放「埃尔林·哈兰德」这类六字名再加一条英文原名。 */
.table.scorer .tr {
  height: 88rpx;
}

.th-player,
.td-player {
  flex: 1;
  min-width: 0;
  padding-right: 10rpx;
}

.th-val,
.td-val {
  flex: none;
  width: 96rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.th-played,
.td-played {
  flex: none;
  width: 88rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.td-val {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text);
}

.td-played {
  font-size: 24rpx;
  color: var(--sub);
}

.th-player,
.th-val,
.th-played {
  font-size: 21rpx;
  color: var(--muted);
  font-weight: 600;
}

.player-name {
  display: flex;
  align-items: baseline;
  overflow: hidden;
  white-space: nowrap;
}

.player-name > text:first-child {
  flex: none;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-en {
  flex: none;
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--muted);
}

.player-team {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 28rpx 0;
}

.meta-main {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sub);
}

.meta-sub {
  font-size: 22rpx;
  color: var(--muted);
}

.season-note {
  margin: 6rpx 28rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.group-head {
  display: flex;
  align-items: center;
  margin: 28rpx 28rpx 12rpx;
}

.group-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

.group-name {
  flex: none;
  margin: 0 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--sub);
}

/* ------------------------------------------------------------------ 表格
   紧凑排版：# + 球队 + 3~4 个数字列。球队列吃掉全部剩余宽度，
   名字不再折叠（2026-10-02 用户反馈 8 列时「巴塞罗那」只剩「巴」）。 */

.table {
  margin: 12rpx 24rpx 0;
  overflow: visible; /* zone-chip 要悬出行边界 */
}

.tr {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  height: 72rpx;
  border-bottom: 2rpx solid var(--line);
}

.tr:last-child {
  border-bottom: none;
}

.tr-hover {
  opacity: 0.75;
}

.th {
  height: 60rpx;
  background: #f6f7fa;
  font-size: 21rpx;
  color: var(--muted);
  font-weight: 600;
}

/* 数字列固定宽、右对齐（tabular 数字），队名列占满剩余空间。
   ⚠️ 宽度是算出来的：750 - 名次52 - 4列×104 - 左右padding32 = 250rpx。
  250rpx / 27rpx 字号 ≈ 9 个汉字的宽度，够放下「布伦特福德」「诺丁汉森林」这类长名。
  再往宽调数字列，队名就会被折叠成两个字（2026-10-02 用户反馈过两次）。 */
.th-pos,
.td-pos {
  flex: none;
  width: 52rpx;
  display: flex;
  align-items: center;
}

.th-team,
.td-team {
  flex: 1;
  min-width: 0;
}

.td {
  flex: none;
  width: 104rpx;
  text-align: right;
  font-size: 25rpx;
  color: var(--sub);
  font-variant-numeric: tabular-nums;
}

.td.strong {
  font-weight: 700;
  color: var(--text);
}

.pos-num {
  font-size: 25rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.team-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding-right: 8rpx;
}

/* 分区标签：悬在色带第一行的上缘（参考图的样式） */
.zone-chip {
  position: absolute;
  right: 12rpx;
  top: -18rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  z-index: 2;
}

/* 色带行交界处压一条细线，标签悬在上面更清楚 */
.tr.zoned {
  border-bottom-color: rgba(16, 24, 40, 0.04);
}

/* ------------------------------------------------------------------ 图例 */

.legend {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 28rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 28rpx;
  font-size: 22rpx;
  color: var(--sub);
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border-radius: 5rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
}
