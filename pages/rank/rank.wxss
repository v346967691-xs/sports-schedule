.chip-bar {
  white-space: nowrap;
  padding: 20rpx 0 18rpx;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}

.chip-bar .chip {
  background: var(--bg);
}

.chip-bar .chip:first-child {
  margin-left: 24rpx;
}

.chip-bar .chip:last-child {
  margin-right: 24rpx;
}

.meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 28rpx 0;
}

.meta-main {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sub);
}

.meta-sub {
  font-size: 22rpx;
  color: var(--muted);
}

.season-note {
  margin: 6rpx 28rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.group-head {
  display: flex;
  align-items: center;
  margin: 28rpx 28rpx 12rpx;
}

.group-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

.group-name {
  flex: none;
  margin: 0 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--sub);
}

/* ------------------------------------------------------------------ 表格
   紧凑排版：# + 球队 + 3~4 个数字列。球队列吃掉全部剩余宽度，
   名字不再折叠（2026-10-02 用户反馈 8 列时「巴塞罗那」只剩「巴」）。 */

.table {
  margin: 12rpx 24rpx 0;
  overflow: visible; /* zone-chip 要悬出行边界 */
}

.tr {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 72rpx;
  border-bottom: 2rpx solid var(--line);
}

.tr:last-child {
  border-bottom: none;
}

.tr-hover {
  opacity: 0.75;
}

.th {
  height: 60rpx;
  background: #f6f7fa;
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 600;
}

/* 数字列固定宽、右对齐（tabular 数字），队名列占满剩余空间 */
.th-pos,
.td-pos {
  flex: none;
  width: 56rpx;
  display: flex;
  align-items: center;
}

.th-team,
.td-team {
  flex: 1;
  min-width: 0;
}

.td {
  flex: none;
  width: 118rpx;
  text-align: right;
  font-size: 25rpx;
  color: var(--sub);
  font-variant-numeric: tabular-nums;
}

.td.strong {
  font-weight: 700;
  color: var(--text);
}

.pos-num {
  font-size: 25rpx;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.team-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding-right: 12rpx;
}

/* 分区标签：悬在色带第一行的上缘（参考图的样式） */
.zone-chip {
  position: absolute;
  right: 12rpx;
  top: -18rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  z-index: 2;
}

/* 色带行交界处压一条细线，标签悬在上面更清楚 */
.tr.zoned {
  border-bottom-color: rgba(16, 24, 40, 0.04);
}

/* ------------------------------------------------------------------ 图例 */

.legend {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx 28rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 28rpx;
  font-size: 22rpx;
  color: var(--sub);
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 8rpx;
  border-radius: 5rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 44rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
}
