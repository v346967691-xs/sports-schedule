/* 「我的开赛提醒」管理页 */

.rm-row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}

.rm-row:last-child {
  border-bottom: none;
}

.rm-row.started {
  opacity: 0.62;
}

.rm-main {
  flex: 1;
  min-width: 0;
}

.rm-top {
  display: flex;
  align-items: center;
}

.rm-comp {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.rm-when {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.rm-when.dim {
  color: var(--muted);
  font-weight: 400;
}

.rm-teams {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rm-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.rm-del {
  flex: none;
  margin-left: 20rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--sub);
  font-size: 24rpx;
}

.rm-del:active {
  background: var(--line);
}

/* 页面内通用按钮（与详情页 btn 保持一致） */
.btn {
  display: block;
  padding: 22rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.btn.ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--line);
}

.btn.ghost:active {
  background: var(--bg);
}
