<!-- 离屏 canvas：只在转发前画分享卡用，移出屏幕而非 display:none（隐藏后取不到节点） -->
<canvas type="2d" id="share-canvas" class="share-canvas"></canvas>

<view class="page schedule">
  <view class="cat-bar">
    <view
      wx:for="{{cats}}"
      wx:key="key"
      class="cat {{item.key === activeCat ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCatTap"
    >
      <image class="sport-icon cat-sport-icon" src="/images/sport-{{item.key}}-white.png" mode="aspectFit"/>
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="filter-bar">
    <view class="competition-filter-row">
      <scroll-view class="chip-row-wrap competition-chip-scroll" scroll-x enable-flex>
        <view class="chip-row">
          <view class="chip {{activeComp === '' ? 'active' : ''}}" data-key="" bindtap="onCompTap">全部</view>
          <view
            wx:for="{{catComps}}"
            wx:key="key"
            class="chip {{item.key === activeComp ? 'active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onCompTap"
          >
            <image class="sport-icon" wx:if="{{item.cat}}" src="/images/sport-{{item.cat}}{{item.key === activeComp ? '-white' : ''}}.png" mode="aspectFit"/>{{item.name}}
          </view>
        </view>
      </scroll-view>
      <view class="comp-sort-entry" bindtap="onCompSortOpen">排序</view>
    </view>

    <view class="mode-switch">
      <view class="mode {{mode === 'upcoming' ? 'active' : ''}}" data-mode="upcoming" bindtap="onModeTap">即将开赛</view>
      <view class="mode {{mode === 'live' ? 'active' : ''}}" data-mode="live" bindtap="onModeTap">进行中</view>
      <view class="mode {{mode === 'finished' ? 'active' : ''}}" data-mode="finished" bindtap="onModeTap">已结束</view>
    </view>

    <scroll-view class="chip-row-wrap stage-row-wrap" scroll-x enable-flex wx:if="{{activeCat === 'tennis' && tournamentChips.length}}">
      <view class="chip-row">
        <text class="filter-level-label">分站</text>
        <view class="chip stage-chip {{tournamentFilter === '' ? 'active' : ''}}" data-key="" bindtap="onTournamentTap">全部分站</view>
        <view wx:for="{{tournamentChips}}" wx:key="key"
          class="chip stage-chip {{tournamentFilter === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="onTournamentTap">{{item.label}}</view>
      </view>
    </scroll-view>

    <!-- 阶段（轮次）筛选：只在这项赛事真有多个轮次时出现。
         足球联赛 / NBA 常规赛的 stage 就是赛事名本身，只有一个取值 → stageChips.length 为 1，整条不渲染。
         有轮次的赛事（全球总决赛 / LPL 周赛 / KPL）用它把一屏几十场收敛到「入围赛」「瑞士轮」这样一段。 -->
    <scroll-view class="chip-row-wrap stage-row-wrap" scroll-x enable-flex wx:if="{{stageChips.length > 1}}">
      <view class="chip-row">
        <text class="filter-level-label" wx:if="{{activeCat === 'tennis'}}">轮次</text>
        <view class="chip stage-chip {{stageFilter === '' ? 'active' : ''}}" data-key="" bindtap="onStageTap">{{activeCat === 'tennis' ? '全部轮次' : '全部阶段'}}</view>
        <view
          wx:for="{{stageChips}}"
          wx:key="key"
          class="chip stage-chip {{stageFilter === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onStageTap"
        >{{item.key}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="tennis-station-entry" wx:if="{{activeCat === 'tennis' && tournamentFilter}}" bindtap="goTournament">
    <view><view class="tennis-station-title">{{tournamentLabel}}</view><view class="tennis-station-desc">完整分站赛程 · 按球场查看 · 晋级图</view></view><text>›</text>
  </view>
  <scroll-view class="chip-row-wrap tennis-courts" scroll-x enable-flex wx:if="{{activeCat === 'tennis' && tournamentFilter && courtChips.length}}">
    <view class="chip-row">
      <text class="filter-level-label">球场</text>
      <view class="chip stage-chip {{courtFilter === '' ? 'active' : ''}}" data-key="" bindtap="onCourtTap">全部球场</view>
      <view class="chip stage-chip {{courtFilter === item.key ? 'active' : ''}}" wx:for="{{courtChips}}" wx:key="key" data-key="{{item.key}}" bindtap="onCourtTap">{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="comp-sort-mask" wx:if="{{showCompSort}}" bindtap="onCompSortClose">
    <view class="comp-sort-panel" catchtap="stopCompSortTap">
      <view class="comp-sort-header">
        <view>
          <view class="comp-sort-title">赛事排序</view>
          <view class="comp-sort-hint">跨类别统一排序 · ATP等也可移到最前</view>
        </view>
        <view class="comp-sort-close" bindtap="onCompSortClose">完成</view>
      </view>
      <scroll-view class="comp-sort-list" scroll-y>
        <view class="comp-sort-item {{index === compSortDragIndex ? 'dragging' : ''}}" wx:for="{{compSortRows}}" wx:key="key"
          style="transform: translateY({{index === compSortDragIndex ? compSortDragOffset : 0}}px); z-index: {{index === compSortDragIndex ? 2 : 0}}">
          <view class="comp-sort-drag-handle" data-index="{{index}}" bindtouchstart="onCompSortDragStart"
            catchtouchmove="onCompSortDragMove" bindtouchend="onCompSortDragEnd" bindtouchcancel="onCompSortDragEnd">☰</view>
          <view class="comp-sort-color" style="background: {{item.accent}}"></view>
          <view class="comp-sort-name">{{item.name}}<text class="comp-sort-category">{{item.categoryName}}</text></view>
          <view class="comp-sort-arrows">
            <view class="comp-sort-pin" data-index="{{index}}" bindtap="onCompSortPin">置顶</view>
            <view class="comp-sort-arrow {{index === 0 ? 'disabled' : ''}}" data-index="{{index}}" data-direction="-1" bindtap="onCompSortMove">↑</view>
            <view class="comp-sort-arrow {{index === compSortRows.length - 1 ? 'disabled' : ''}}" data-index="{{index}}" data-direction="1" bindtap="onCompSortMove">↓</view>
          </view>
        </view>
      </scroll-view>
      <view class="comp-sort-reset" bindtap="onCompSortReset">恢复默认顺序</view>
    </view>
  </view>

  <!-- 有排行榜的赛事才出现：看赛程的时候顺手能查排名 -->
  <view class="rank-entry" wx:if="{{hasStandings}}" bindtap="onRankTap" hover-class="rank-entry-hover">
    <text class="rank-entry-text">查看 {{compName}} 排行榜</text>
    <text class="rank-entry-go">›</text>
  </view>

  <view class="stale-tip" wx:if="{{stale}}">
    数据{{staleLabel}}，比分可能不是最新结果
  </view>

  <view class="empty" wx:if="{{loadError}}">
    <view class="empty-title">数据没能加载出来</view>
    <view class="empty-desc">{{loadError}}</view>
  </view>

  <view class="team-banner" wx:if="{{teamFilter}}">
    <view class="team-banner-info">
      <view class="team-banner-dot" style="background: {{teamFilter.color}}"></view>
      <view class="team-banner-text">只看 <text class="team-banner-name">{{teamFilter.display}}</text> 的比赛</view>
    </view>
    <view class="team-banner-clear" bindtap="onClearTeam">取消</view>
  </view>

  <!--
    淘汰赛对阵树：选中八强 / 半决赛 / 决赛时出现。
    🔴 连线是「同轮次内按开赛时间两两配对」**推断**出来的 —— 上游 previousMatchIds 恒为空，
       官方根本不给晋级关系；因此每段连线都经过「胜者集合 ↔ 下一轮双方集合」自校验，
       校验不过就整段不画线（只留分列），见 utils/bracket.js 的 canLink()。
    ⚠️ 几何（卡片位置、连线端点）全部在 utils/bracket.js 里算完，模板只负责铺开。
    ⚠️ 嵌套 wx:for 必须显式写 wx:for-index，否则内层 `index` 会盖掉外层。
  -->
  <view class="ko" wx:if="{{bracket}}">
    <view class="ko-title">淘汰赛对阵</view>

    <view class="ko-heads">
      <block wx:for="{{bracket.items}}" wx:key="key" wx:for-item="it" wx:for-index="ii">
        <view class="ko-head" wx:if="{{it.type === 'col'}}">{{it.label}}</view>
        <view class="ko-head-gap" wx:else></view>
      </block>
    </view>

    <view class="ko-tree">
      <block wx:for="{{bracket.items}}" wx:key="key" wx:for-item="it" wx:for-index="ii">
        <view class="ko-col" wx:if="{{it.type === 'col'}}" style="padding-top: {{it.padTop}}rpx">
          <view
            class="ko-node"
            wx:for="{{it.nodes}}"
            wx:for-item="n"
            wx:for-index="ni"
            wx:key="id"
            data-id="{{n.id}}"
            bindtap="goDetail"
            hover-class="ko-node-hover"
          >
            <view class="ko-row {{r.win ? 'win' : ''}}" wx:for="{{n.rows}}" wx:for-item="r" wx:for-index="ri" wx:key="idx">
              <view class="ko-dot" style="background: {{r.color}}"></view>
              <view class="ko-name">{{r.name}}</view>
              <view class="ko-score" wx:if="{{n.hasScore}}">{{r.score}}</view>
            </view>
          </view>
        </view>

        <view class="ko-gap" wx:else style="height: {{it.height}}rpx">
          <view
            class="ko-seg"
            wx:for="{{it.segs}}"
            wx:for-item="sg"
            wx:for-index="si"
            wx:key="k"
            style="left: {{sg.left}}rpx; top: {{sg.top}}rpx; width: {{sg.width}}rpx; height: {{sg.height}}rpx"
          ></view>
        </view>
      </block>
    </view>

    <view class="ko-note">
      连线为「同轮次按时间顺序两两配对」的推断结果，已用官方赛果自校验；点任一场看详情。
    </view>
  </view>

  <view class="summary" wx:if="{{totalMatches}}">
    共 {{totalMatches}} 场比赛，分布在 {{totalGroups}} 个比赛日
    <block wx:if="{{updatedAt}}"> · 数据 {{updatedAt}}{{source === 'cloud' ? '（云端）' : '（本地）'}}</block>
  </view>

  <block wx:for="{{rows}}" wx:key="key">
    <view class="day-head" wx:if="{{item.type === 'head'}}">
      <text class="day-title">{{item.dayLabel}}</text>
      <text class="day-count">{{item.count}} 场</text>
    </view>

    <view class="mc" wx:if="{{item.type === 'match'}}" data-id="{{item.match.id}}" bindtap="goDetail" hover-class="mc-hover">
      <view class="mc-head">
        <image class="sport-icon" wx:if="{{item.match._comp.cat}}" src="/images/sport-{{item.match._comp.cat}}.png" mode="aspectFit"/><view class="mc-tag" style="background: {{item.match._accent}}">{{item.match._compName}}</view>
        <view class="mc-stage" wx:if="{{item.match._stageLabel}}">{{item.match._stageLabel}}</view>
        <view class="mc-broadcast" wx:if="{{item.match._broadcastLabel}}">{{item.match._broadcastLabel}}</view>
        <view class="mc-followed" wx:if="{{item.match._isFav}}" aria-label="已关注比赛" role="img"><view class="mc-followed-eye"></view></view>
        <view class="mc-status status-{{item.match.status}}">{{item.match._statusLabel}}</view>
      </view>

      <view class="mc-body">
        <view class="mc-time">
          <view class="mc-time-main">{{item.match.time}}</view>
          <view class="mc-time-sub">{{item.match._weekday}}</view>
        </view>
        <view class="mc-line"></view>
        <view class="mc-teams">
          <view class="mc-row">
            <view class="mc-dot" style="background: {{item.match.home.color}}"></view>
            <view class="mc-name {{item.match._isTennis ? 'tennis-name' : ''}} {{item.match._homeWin ? 'win' : ''}}">{{item.match.home.zhName}}<text class="tennis-seed" wx:if="{{item.match.home.seed}}">[{{item.match.home.seed}}]</text></view><text class="tennis-retired" wx:if="{{item.match.home.retired}}">退赛</text>
            <view class="mc-form" wx:if="{{item.match._homeForm.length}}"><view class="ff ff-{{f}}" wx:for="{{item.match._homeForm}}" wx:for-item="f" wx:key="index"></view></view>
            <view class="mc-score {{item.match._homeWin ? 'win' : ''}}" wx:if="{{item.match._hasScore}}">{{item.match.home.score}}</view>
          </view>
          <view class="mc-row">
            <view class="mc-dot" style="background: {{item.match.away.color}}"></view>
            <view class="mc-name {{item.match._isTennis ? 'tennis-name' : ''}} {{item.match._awayWin ? 'win' : ''}}">{{item.match.away.zhName}}<text class="tennis-seed" wx:if="{{item.match.away.seed}}">[{{item.match.away.seed}}]</text></view><text class="tennis-retired" wx:if="{{item.match.away.retired}}">退赛</text>
            <view class="mc-form" wx:if="{{item.match._awayForm.length}}"><view class="ff ff-{{f}}" wx:for="{{item.match._awayForm}}" wx:for-item="f" wx:key="index"></view></view>
            <view class="mc-score {{item.match._awayWin ? 'win' : ''}}" wx:if="{{item.match._hasScore}}">{{item.match.away.score}}</view>
          </view>
        </view>
      </view>

      <view class="mc-foot" wx:if="{{item.match._statusHint || item.match._bo || item.match._historical || item.match._courtLabel}}">
        <text class="mc-hint" wx:if="{{item.match._courtLabel}}">{{item.match._courtLabel}}</text>
        <text class="mc-hint" wx:if="{{item.match._statusHint}}">{{item.match._statusHint}}</text>
        <text class="mc-badge" wx:if="{{item.match._bo}}">{{item.match._bo}}</text>
        <text class="mc-badge ghost" wx:if="{{item.match._historical}}">历史战绩</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!rows.length && !loadError}}">
    <view class="empty-title">
      {{mode === 'upcoming' ? '暂无已公布的未来赛程' : mode === 'live' ? '暂无进行中的比赛' : '暂无已结束的比赛'}}
    </view>
    <view class="empty-desc">
      {{mode === 'upcoming'
        ? '该项赛事正处于赛季间歇期，官方尚未放出新的日程。可以先切换到「已结束」查看最近战绩。'
        : mode === 'live'
          ? '当前没有正在进行的比赛，可以切换到「即将开赛」或「已结束」。'
          : '换一个赛事或切换回「即将开赛」看看。'}}
    </view>
  </view>

  <view class="more" wx:if="{{shownGroups < totalGroups}}" bindtap="onLoadMore">显示更多比赛日</view>
  <view class="safe-bottom"></view>
</view>
