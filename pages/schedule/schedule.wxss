.schedule {
  padding-top: 0;
}

.cat-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #14235c 0%, #26377e 55%, #3b4ea8 100%);
}

.cat {
  position: relative;
  padding: 24rpx 0 20rpx;
  margin-right: 44rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 30rpx;
}

.cat.active {
  color: #fff;
  font-weight: 700;
}

.cat.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: #fff;
}

.team-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
}

.team-banner-info {
  display: flex;
  align-items: center;
}

.team-banner-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.team-banner-text {
  font-size: 26rpx;
  color: var(--brand);
}

.team-banner-name {
  font-weight: 700;
}

.team-banner-clear {
  flex: none;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--brand);
  font-size: 24rpx;
}

.filter-bar {
  background: #fff;
  border-bottom: 2rpx solid var(--line);
  padding-bottom: 16rpx;
}

.chip-row-wrap {
  white-space: nowrap;
  padding-top: 18rpx;
}

.chip-row-wrap::-webkit-scrollbar {
  display: none;
}

.chip-row {
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  margin-right: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--sub);
  font-size: 26rpx;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.chip.active {
  background: var(--brand);
  color: #fff;
  font-weight: 600;
}

.chip-accent {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

/* 阶段（轮次）筛选条：接在模式开关下面，样式沿用赛事 chip，只是更轻一档 */
.stage-row-wrap {
  padding-top: 14rpx;
}

.chip.stage-chip {
  margin-right: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.mode-switch {
  display: flex;
  margin: 8rpx 24rpx 0;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--bg);
}

/* 选了具体赛事且该赛事有积分榜时才出现的入口条 */
.rank-entry {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand);
}

.rank-entry-hover {
  opacity: 0.7;
}

.rank-entry-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
}

.rank-entry-go {
  flex: none;
  margin-left: 10rpx;
  font-size: 28rpx;
}

.mode {
  flex: 1;
  padding: 12rpx 0;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--sub);
}

.mode.active {
  background: #fff;
  color: var(--brand);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.08);
}

.fallback-tip {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #fff6e5;
  color: #93450a;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 数据陈旧警告：定时任务停了（如电脑关机）时提示用户比分可能不是最新的 */
.stale-tip {
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  background: #fff1f0;
  color: #b42318;
  font-size: 23rpx;
  line-height: 1.6;
  font-weight: 600;
}

.summary {
  padding: 20rpx 32rpx 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.day-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 24rpx 32rpx 8rpx;
}

.day-title {
  font-size: 28rpx;
  font-weight: 700;
}

.day-count {
  font-size: 22rpx;
  color: var(--muted);
}

.more {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #fff;
  color: var(--brand);
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
}

/* ---------- 淘汰赛对阵树 ----------
   🔴 卡片高 92rpx、同列卡间距 18rpx、两列之间走廊宽 36rpx，**必须与 utils/bracket.js 的
      NODE_H / NODE_GAP / LINK_W 一致** —— 连线端点的纵坐标就是按这三个数算出来的。
      改动任何一处都要同步改另一处，否则连线整体错位（与排行页 COLUMNS ↔ renderRow 同类）。
   ⚠️ 不用 flex `gap`（老 WebView 不支持），列内间距一律用 margin。 */
.ko {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 16rpx 22rpx;
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: 0 2rpx 12rpx rgba(16, 24, 40, 0.05);
}

.ko-title {
  margin: 0 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.ko-heads {
  display: flex;
  align-items: center;
  margin: 0 0 14rpx;
}

.ko-head {
  flex: 1;
  min-width: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 表头行的走廊占位：宽度必须与 .ko-gap 相同，否则列头和列身对不齐 */
.ko-head-gap {
  flex: none;
  width: 36rpx;
}

.ko-tree {
  display: flex;
  align-items: flex-start;
}

.ko-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ko-gap {
  position: relative;
  flex: none;
  width: 36rpx;
}

/* 一条连线线段。位置和长度全部由 bracket.js 算好，这里只负责画出来 */
.ko-seg {
  position: absolute;
  background: var(--line);
}

.ko-node {
  box-sizing: border-box;
  height: 92rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.ko-node + .ko-node {
  margin-top: 18rpx;
}

.ko-node-hover {
  background: var(--brand-soft);
}

.ko-row {
  display: flex;
  align-items: center;
  height: 44rpx;
  padding: 0 10rpx;
}

.ko-dot {
  flex: none;
  width: 8rpx;
  height: 22rpx;
  margin-right: 8rpx;
  border-radius: 4rpx;
}

.ko-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ko-score {
  flex: none;
  min-width: 26rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--muted);
}

/* 与比赛卡同一套口径：胜者更黑更重，负者留灰 */
.ko-row.win .ko-name {
  color: var(--text);
  font-weight: 700;
}

.ko-row.win .ko-score {
  color: var(--brand);
  font-weight: 800;
}

.ko-note {
  margin: 18rpx 8rpx 0;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* 离屏 canvas：只用于转发前绘制分享卡，移出屏幕而不是 display:none */
.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 500px;
  height: 400px;
}

/* 赛前前瞻：双方近 5 场胜平负色块（只在看未来赛程时出现）
   ⚠️ 不用 flex `gap`（老 WebView 不支持），间距一律 margin-right */
.mc-form {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 10rpx;
}

.ff {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
  margin-right: 4rpx;
}

.ff:last-child {
  margin-right: 0;
}

/* 胜绿 / 平灰 / 负红 —— 足球通行口径，与 standings 的 zone、分享卡近况块同色系 */
.ff-W {
  background: #2F7A52;
}

.ff-D {
  background: #8A93A6;
}

.ff-L {
  background: #C33A3A;
}
