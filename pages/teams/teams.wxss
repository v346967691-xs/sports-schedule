.tf-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 8rpx;
}

.tf-count {
  font-size: 28rpx;
  color: #6B7280;
}

.tf-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #14235C;
  margin: 0 8rpx;
}

.tf-clear {
  font-size: 26rpx;
  color: #DC2626;
  padding: 8rpx 20rpx;
  border: 1rpx solid #FCA5A5;
  border-radius: 999rpx;
}

.tf-clear.is-dim {
  color: #C0C6D2;
  border-color: #E5E8EF;
}

.tf-cats-wrap {
  white-space: nowrap;
  padding: 12rpx 20rpx 4rpx;
}

.tf-cats {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tf-cat {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #F1F3F7;
  color: #5A6376;
  font-size: 27rpx;
  white-space: nowrap;
}

.tf-cat.active {
  background: #14235C;
  color: #FFFFFF;
  font-weight: 600;
}

.tf-cat-num {
  margin-left: 10rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #E8452B;
  color: #FFFFFF;
  font-size: 20rpx;
}

.tf-search {
  position: relative;
  padding: 16rpx 28rpx 8rpx;
}

.tf-input {
  height: 76rpx;
  padding: 0 68rpx 0 28rpx;
  border-radius: 16rpx;
  background: #F1F3F7;
  font-size: 28rpx;
  color: #1F2733;
}

.tf-ph {
  color: #A6AEBC;
}

.tf-kw-clear {
  position: absolute;
  right: 46rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #9AA2B1;
  font-size: 26rpx;
}

.tf-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 8rpx 20rpx 0;
}

.tf-team {
  position: relative;
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(20, 35, 92, 0.06);
  overflow: hidden;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tf-team-hover {
  background: #F7F8FB;
}

.tf-team.on {
  background: #EEF1FA;
  box-shadow: inset 0 0 0 2rpx #14235C;
}

.tf-bar {
  width: 8rpx;
  height: 56rpx;
  border-radius: 4rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.tf-body {
  flex: 1;
  min-width: 0;
}

.tf-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2733;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-abbr {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9AA2B1;
  letter-spacing: 1rpx;
}

/* 积分榜摘要：有排名的队伍多出一行，卡片高度会变，用 min-height 兜住对齐 */
.tf-rank {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A93A6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tf-check {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F1F3F7;
  color: #7A8395;
  font-size: 22rpx;
}

.tf-team.on .tf-check {
  background: #14235C;
  color: #FFFFFF;
}

.tf-foot {
  margin: 24rpx 28rpx 0;
  font-size: 23rpx;
  color: #A0A7B4;
  line-height: 1.6;
}
