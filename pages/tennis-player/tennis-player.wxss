.athlete-page{padding-bottom:40rpx}.athlete-hero{background:linear-gradient(125deg,#134d39,#267758);color:#fff;padding:34rpx 28rpx}.athlete-heading{display:flex;align-items:center}.portrait{width:120rpx;height:140rpx;border-radius:16rpx;background:#fff;margin-right:22rpx;flex:none}.athlete-heading-text{min-width:0;flex:1}.athlete-tour{font-size:22rpx;color:#b7dec9}.athlete-name{font-size:36rpx;font-weight:800;margin-top:12rpx;line-height:1.4}.athlete-en{font-size:23rpx;opacity:.8;margin-top:8rpx}.athlete-follow{display:inline-block;margin-top:24rpx;padding:12rpx 26rpx;background:rgba(255,255,255,.15);border-radius:999rpx;font-size:25rpx}.athlete-section{background:#fff;margin:22rpx 24rpx;padding:26rpx;border-radius:20rpx}.athlete-section-title{font-size:29rpx;font-weight:750;color:#14235c;margin-bottom:22rpx}.athlete-points{display:flex;justify-content:space-between}.athlete-points>view{flex:1}.point-label{font-size:20rpx;color:#8a93a6}.point-number{font-size:36rpx;font-weight:800;color:#14235c;margin:14rpx 0}.point-number.delta{font-size:30rpx;color:#1c6b45}.athlete-note{font-size:22rpx;line-height:1.7;color:#8a93a6;margin-top:12rpx}.points-detail{border-top:1rpx solid #eef0f4;padding-top:20rpx;margin-top:22rpx}.points-heading{font-size:24rpx;font-weight:600;color:#5d6d87}.points-row{display:flex;justify-content:space-between;margin-top:12rpx;font-size:23rpx;line-height:1.6}.points-row>text:first-child{flex:1;margin-right:18rpx}.points-row>text+text{flex:none;color:#1c6b45;font-weight:700}.profile-row{display:flex;justify-content:space-between;border-bottom:1rpx solid #f1f3f7;padding:16rpx 0;font-size:25rpx}.profile-row>text:first-child{color:#8a93a6}.profile-row>text+text{color:#14235c;margin-left:20rpx}.eligibility-status{display:inline-block;margin-top:6rpx;font-size:24rpx;font-weight:650;color:#8c7451;background:#f8f3e9;padding:10rpx 14rpx;border-radius:10rpx;line-height:1.5}.eligibility-status.confirmed{color:#1c6b45;background:#e8f3ed}.eligibility-status.contending{color:#304f9a;background:#edf1fc}.eligibility-status.withdrawn{color:#996c72;background:#f6edef}.race-points{font-size:29rpx;font-weight:700;margin-top:24rpx;color:#14235c}.race-gap{font-size:24rpx;color:#687b98;margin-top:14rpx}.eligibility-item{border-top:1rpx solid #eef0f4;padding-top:22rpx;margin-top:22rpx}.eligibility-name{font-size:26rpx;font-weight:650;color:#14235c}.eligibility-name>text{font-size:20rpx;color:#8a93a6;margin-left:10rpx}.eligibility-date{font-size:21rpx;color:#8a93a6;margin:10rpx 0}.athlete-match{padding:20rpx 0;border-bottom:1rpx solid #eef0f4;font-size:25rpx;line-height:1.6}.athlete-warning{margin-top:16rpx;background:#faf1df;color:#997d4b;font-size:22rpx;padding:16rpx;border-radius:10rpx}
.point-number.delta.negative{color:#a96666}
