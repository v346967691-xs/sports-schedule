<view class="event-page">
  <view class="empty" wx:if="{{error}}">{{error}}</view>
  <block wx:if="{{event}}">
    <view class="event-hero">
      <view class="event-kicker">TENNIS · {{event.year}}</view>
      <view class="event-title">{{event.name}}</view>
      <view class="event-subtitle">{{event.title}}</view>
      <view class="event-level"><image class="sport-icon" src="/images/sport-tennis-white.png" mode="aspectFit"/>{{event.levelLabel}}</view>
      <view class="event-period">{{event.startLabel}} {{event.endLabel}}</view>
    </view>
    <view class="event-tabs">
      <view class="event-tab {{tab === 'schedule' ? 'selected' : ''}}" data-key="schedule" bindtap="onTab">球场赛程</view>
      <view class="event-tab {{tab === 'bracket' ? 'selected' : ''}}" data-key="bracket" bindtap="onTab">完整晋级图</view>
    </view>
    <view class="event-filters">
      <view class="event-chips">
        <view wx:for="{{tours}}" wx:key="key" class="event-chip {{activeTour === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onTour">{{item.name}}</view>
      </view>
      <block wx:if="{{tab === 'schedule'}}">
        <scroll-view scroll-x class="event-scroll"><view class="event-chips nowrap">
          <view class="event-chip {{courtFilter === '' ? 'active' : ''}}" data-key="" bindtap="onCourt">全部球场</view>
          <view wx:for="{{courts}}" wx:key="key" class="event-chip {{courtFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onCourt">{{item.name}}</view>
        </view></scroll-view>
        <scroll-view scroll-x class="event-scroll"><view class="event-chips nowrap">
          <view class="event-chip {{dateFilter === '' ? 'active' : ''}}" data-key="" bindtap="onDate">全部日期</view>
          <view wx:for="{{dates}}" wx:key="key" class="event-chip {{dateFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onDate">{{item.name}}</view>
        </view></scroll-view>
        <view class="event-chips">
          <view wx:for="{{statuses}}" wx:key="key" class="event-chip small {{statusFilter === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onStatus">{{item.name}}</view>
        </view>
      </block>
    </view>
    <block wx:if="{{tab === 'schedule'}}">
      <view class="event-count">{{total}} 场比赛 · 点击对阵查看详情、关注和提醒</view>
      <view class="empty" wx:if="{{!total}}">当前筛选下没有比赛</view>
      <block wx:for="{{groups}}" wx:for-item="group" wx:key="date">
        <view class="event-day">{{group.date}} {{group.weekday}}</view>
        <view class="mc" wx:for="{{group.items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail" hover-class="mc-hover">
          <view class="mc-head">
            <image class="sport-icon" wx:if="{{item._comp.cat}}" src="/images/sport-{{item._comp.cat}}.png" mode="aspectFit"/><view class="mc-tag" style="background:{{item._accent}}">{{item._compName}}</view>
            <view class="mc-stage">{{item._roundNameRaw}}</view>
            <view class="mc-broadcast" wx:if="{{item._broadcastLabel}}">{{item._broadcastLabel}}</view>
            <view class="mc-status status-{{item.status}}">{{item._statusLabel}}</view>
          </view>
          <view class="event-match-body">
            <view class="event-match-time">{{item.time}}</view>
            <view class="event-match-teams">
              <view class="event-player"><text>{{item.home.zhName}}<text class="tennis-seed" wx:if="{{item.home.seed}}">[{{item.home.seed}}]</text></text><text class="tennis-retired" wx:if="{{item.home.retired}}">退赛</text><text class="event-player-score">{{item._hasScore ? item.home.score : ''}}</text></view>
              <view class="event-player"><text>{{item.away.zhName}}<text class="tennis-seed" wx:if="{{item.away.seed}}">[{{item.away.seed}}]</text></text><text class="tennis-retired" wx:if="{{item.away.retired}}">退赛</text><text class="event-player-score">{{item._hasScore ? item.away.score : ''}}</text></view>
            </view>
          </view>
          <view class="event-match-court">{{item.courtName}}</view>
        </view>
      </block>
      <view class="event-more" wx:if="{{total > shown}}" bindtap="loadMore">查看更多比赛</view>
    </block>
    <block wx:else>
      <elimination-board tree="{{boardTree}}" panes="{{bracketPages}}" navigation="{{roundNavigation}}" current="{{bracketIndex}}" zoom-label="{{zoomLabel}}" auto-fit="{{autoFit}}" bindzoom="onZoom" bindround="onBracketRound" bindswipe="onBracketSwipe" bindautofit="onAutoFit" bindmatchtap="onBoardMatch"/>
    </block>
    <view class="event-footer">比分与赛程随数据刷新更新 · 整站赛程保留至赛后 30 天</view>
  </block>
</view>
