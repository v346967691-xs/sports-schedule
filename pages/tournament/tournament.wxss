.event-page { padding-bottom: 48rpx; }
.event-hero { background: linear-gradient(125deg,#134d39,#267758); color: white; padding: 36rpx 30rpx 32rpx; }
.event-kicker { font-size: 20rpx; color: #b7dec9; letter-spacing: 3rpx; }
.event-title { margin-top: 14rpx; font-size: 40rpx; font-weight: 800; }
.event-subtitle { margin-top: 8rpx; font-size: 24rpx; opacity: .85; }
.event-level { display:inline-block; margin-top:14rpx; padding:5rpx 12rpx; border-radius:8rpx; background:rgba(255,255,255,.14); font-size:22rpx; color:#d5eee0; }
.event-period { font-size: 22rpx; opacity: .8; margin-top: 10rpx; }
.event-tabs { display: flex; background: white; padding: 0 24rpx; }
.event-tab { flex: 1; text-align: center; padding: 26rpx 0; font-size: 28rpx; border-bottom: 5rpx solid transparent; color: #8a93a6; }
.event-tab.selected { color: #164e3b; font-weight: 700; border-color: #237451; }
.event-filters { padding: 20rpx 24rpx 8rpx; background: white; }
.event-chips { display: flex; margin-bottom: 16rpx; flex-wrap: wrap; }
.event-chips.nowrap { flex-wrap: nowrap; }
.event-chip { flex: none; font-size: 24rpx; padding: 12rpx 22rpx; margin-right:12rpx; background: #f1f4f7; border-radius: 999rpx; color: #65718a; }
.event-chip.active { color: white; background: #1c6b45; font-weight: 700; }
.event-chip.small { font-size: 22rpx; }
.event-scroll { width: 100%; white-space: nowrap; margin-bottom: 20rpx; }
.event-count,.event-footer { margin: 24rpx; font-size: 22rpx; color: #8a93a6; line-height: 1.7; }
.event-day { margin: 24rpx; font-size: 26rpx; font-weight: 700; }
.event-match-body { display: flex; align-items: center; margin-top: 22rpx; }
.event-match-time { width: 110rpx; font-size: 32rpx; font-weight: 800; color: #14235c; flex: none; }
.event-match-teams { flex: 1; min-width: 0; border-left: 1rpx solid #e5e9ef; padding-left: 22rpx; margin-left:24rpx; }
.event-player { display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; line-height: 1.85; }
.event-player > text:first-child { flex: 1; min-width: 0; }
.event-player-score { font-size: 30rpx; font-weight: 700; color: #14235c; margin-left:16rpx; }
.event-match-court { margin-top: 16rpx; border-top: 1rpx solid #eef0f5; padding-top: 12rpx; font-size: 22rpx; color: #1c6b45; }
.event-more { margin: 24rpx; padding: 24rpx; text-align: center; font-size: 26rpx; background: white; border-radius: 16rpx; color: #14235c; }
