<canvas type="2d" id="share-canvas" class="share-canvas"></canvas>
<canvas type="2d" id="worlds-long-canvas" class="export-canvas"></canvas>
<view class="report-page">
  <view class="report-masthead"><view class="edition-brand">WORLDS 2026</view><view class="report-name">闪现 · S 赛晨报</view><view class="report-date">{{report.date}} · {{report.phase}}</view></view>
  <view class="report-loading" wx:if="{{loading}}">正在整理赛场战况…</view>
  <view class="report-loading" wx:elif="{{error}}">{{error}}</view>
  <block wx:elif="{{report}}">
    <view class="report-stale" wx:if="{{stale}}">数据暂未更新，请下拉刷新。以下为最后可用战况。</view>
    <view class="report-draft" wx:if="{{report.isDraft}}">北京时间 09:00 首发，14:00 更新 · 当前为即时前瞻</view>
    <view class="report-body">
      <view class="report-headline">{{report.title}}</view><view class="report-lead">{{report.lead}}</view>
      <view class="report-section" wx:for="{{sections}}" wx:for-item="section" wx:for-index="sectionIndex" wx:key="key">
        <view class="report-section-title">{{section.title}}<text wx:if="{{section.key === 'next'}}">北京时间</text></view>
        <block wx:if="{{section.key === 'qualification'}}">
          <view class="report-standing" wx:for="{{section.rows}}" wx:for-index="standingIndex" wx:key="record"><view>{{item.record}} · {{item.text}}</view><text>{{item.teams}}</text></view>
        </block>
        <block wx:else>
          <view class="report-match" wx:for="{{section.rows}}" wx:for-item="match" wx:for-index="matchIndex" wx:key="id" data-id="{{match.id}}" bindtap="goMatch">
            <view class="report-match-time">{{match.time}}</view>
            <view class="report-match-top"><view class="report-team {{match.homeWin ? 'winner' : ''}}">{{match.home}}</view><view class="report-score">{{match.score}}</view><view class="report-team away {{match.awayWin ? 'winner' : ''}}">{{match.away}}</view></view>
            <view class="report-match-bottom"><text>{{match.stage}}</text><text>{{section.key === 'next' ? '查看对阵 →' : section.key === 'waiting' ? '等待官方确认' : match.statusText}}</text></view>
          </view>
        </block>
      </view>
      <view class="report-note"><view>{{report.editionLabel}} · 整理于 {{updatedText}} 北京时间</view><view>{{report.note}}</view></view>
      <view class="report-actions"><button class="report-action-primary" open-type="share">分享好友</button><button class="report-action-secondary" bindtap="generatePoster" loading="{{exporting}}" disabled="{{exporting}}">生成长图</button></view>
    </view>
  </block>
  <view class="report-links"><view bindtap="goWorlds">返回 S 赛专区 →</view><picker wx:if="{{editions.length}}" range="{{editions}}" bindchange="onEditionChange">往期晨报 ↓</picker></view>
</view>
