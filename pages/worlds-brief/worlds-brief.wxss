.report-page { min-height: 100vh; background: #fafbfe; padding-bottom: 40rpx; }
.report-masthead { background: #14235c; color: #fff; padding: 44rpx 34rpx 38rpx; }
.edition-brand { color: #c5a263; font-size: 22rpx; font-weight: 700; letter-spacing: 4rpx; }
.report-name { margin-top: 18rpx; font-size: 45rpx; font-weight: 750; }
.report-date { margin-top: 18rpx; font-size: 22rpx; color: #bac5de; }
.report-body { padding: 32rpx; }
.report-headline { font-size: 39rpx; font-weight: 750; color: #192747; line-height: 1.4; }
.report-lead { color: #758096; font-size: 25rpx; line-height: 1.75; margin-top: 16rpx; }
.report-section { margin-top: 34rpx; }.report-section-title { box-sizing: border-box; border-left: 5rpx solid #c5a263; border-radius: 10rpx; background: #eef1f8; padding: 14rpx 16rpx; font-size: 28rpx; font-weight: 700; color: #14235c; }
.report-section-title text { margin-left: 16rpx; color: #758096; font-size: 20rpx; font-weight: 400; }
.report-match { padding: 22rpx 0; border-bottom: 1rpx solid #e4e8f0; }
.report-match-time { margin-bottom: 12rpx; color: #14235c; font-size: 26rpx; line-height: 1.45; font-weight: 700; font-variant-numeric: tabular-nums; }
.report-match-top { display: flex; align-items: center; justify-content: center; }
.report-team { flex: 0 1 auto; max-width: 38%; min-width: 0; text-align: right; font-size: 28rpx; font-weight: 600; overflow-wrap: anywhere; }.report-team.away { text-align: left; }.report-team.winner { color: #14235c; }
.report-score { width: auto; min-width: 76rpx; flex: none; margin: 0 10rpx; text-align: center; color: #14235c; font-size: 34rpx; font-weight: 750; font-variant-numeric: tabular-nums; }
.report-match-bottom { display: flex; justify-content: space-between; margin-top: 10rpx; font-size: 20rpx; color: #758096; }.report-match-bottom > text:first-child { min-width: 0; flex: 1; }.report-match-bottom > text:last-child { flex: none; margin-left: 12rpx; }
.report-standing { padding: 20rpx 0; border-bottom: 1rpx solid #e4e8f0; font-size: 25rpx; color: #14235c; }.report-standing text { display: block; margin-top: 9rpx; color: #758096; font-size: 23rpx; }
.report-note { font-size: 20rpx; line-height: 1.7; color: #758096; margin-top: 34rpx; }
.report-actions { display: flex; align-items: center; margin-top: 26rpx; }
.report-actions button { box-sizing: border-box; flex: 1; min-width: 0; height: 88rpx; margin: 0; padding: 0 12rpx; font-size: 25rpx; line-height: 88rpx; border-radius: 10rpx; }
.report-actions button + button { margin-left: 16rpx; }
.report-actions button::after { border: 0; }
.report-action-primary { background: #14235c; color: #fff; }
.report-action-secondary { border: 2rpx solid #14235c; background: #fff; color: #14235c; }
.report-links { display: flex; justify-content: space-between; padding: 20rpx 32rpx; font-size: 23rpx; color: #14235c; }.report-loading, .report-stale, .report-draft { padding: 22rpx 32rpx; font-size: 23rpx; color: #758096; }.report-stale { background: #fff2db; color: #a36b12; }
.export-canvas { position: fixed; left: -9999px; top: 0; width: 750px; height: 1000px; pointer-events: none; }
/* 离屏 canvas：仅生成顶部分享缩略图，不能占用晨报正文区域。 */
.share-canvas { position: fixed; left: -9999px; top: 0; width: 500px; height: 400px; pointer-events: none; }
