.swiss-hero{margin:24rpx;padding:30rpx;border-radius:22rpx;background:linear-gradient(135deg,#14235c,#35477d);color:#fff}
.swiss-kicker{font-size:23rpx;color:#e3ce9d;display:flex;align-items:center}.swiss-title{font-size:42rpx;font-weight:800;margin:12rpx 0}.swiss-sub{font-size:23rpx;line-height:1.6;opacity:.85}
.swiss-tabs{display:flex;margin:24rpx}.swiss-tab{flex:1;text-align:center;padding:17rpx 0;margin-right:9rpx;background:#fff;border-radius:13rpx;font-size:25rpx;color:#7e8799}.swiss-tab:last-child{margin-right:0}.swiss-tab.selected{background:#14235c;color:#fff;font-weight:700}.swiss-tip{margin:0 26rpx 20rpx;font-size:22rpx;color:#8690a4}
.swiss-scroll{width:100%;box-sizing:border-box}.swiss-columns{display:flex;align-items:flex-start;padding:0 24rpx;box-sizing:border-box}.swiss-column{width:550rpx;flex:none;margin-right:24rpx;box-sizing:border-box}.swiss-round-title{font-size:30rpx;font-weight:800;color:#172454;padding:0 4rpx 20rpx;display:flex;justify-content:space-between;align-items:center}.swiss-round-title>text{font-size:22rpx;font-weight:400;color:#8690a4}
.swiss-pool{background:#e9edf5;border-radius:18rpx;margin-bottom:22rpx;padding:16rpx}.swiss-pool-head{display:flex;align-items:center;justify-content:space-between;padding:3rpx 4rpx 17rpx;font-size:27rpx;font-weight:700;color:#263658}.swiss-pool-hint{font-size:20rpx;font-weight:400;color:#788398}.swiss-pool.advance{background:#e5f1eb}.swiss-pool.eliminate{background:#f2e9e8}.swiss-pool.deciding{background:#f2eddf}
.swiss-match{padding:18rpx 20rpx;background:#fff;border-radius:13rpx;margin-bottom:12rpx;border:2rpx solid transparent}.swiss-match.lpl{border-left:5rpx solid #c5a463}.swiss-match.focused{border-color:#c5a463}.swiss-match-meta{display:flex;justify-content:space-between;font-size:20rpx;color:#8a93a6;margin-bottom:10rpx}.swiss-team-row{display:flex;align-items:center;justify-content:space-between;padding:5rpx 0;font-size:29rpx;color:#667085}.swiss-team-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}.swiss-score{flex:none;margin-left:20rpx;font-weight:700}.swiss-team-row.winner{color:#152552;font-weight:800}.swiss-time{font-size:20rpx;color:#8a93a6;margin-top:10rpx}.swiss-wait{padding:28rpx 14rpx;text-align:center;border:2rpx dashed #c9d0dd;border-radius:12rpx;font-size:24rpx;color:#8993a6}
.swiss-settled{display:flex;margin:24rpx}.swiss-summary{flex:1;min-width:0;background:#fff;border-radius:18rpx;padding:24rpx;margin-right:18rpx}.swiss-summary:last-child{margin-right:0}.swiss-summary-title{font-size:27rpx;font-weight:700;color:#172454;margin-bottom:14rpx}.swiss-muted{font-size:22rpx;color:#8a93a6;line-height:1.7}.swiss-summary-team{display:flex;justify-content:space-between;font-size:25rpx;padding:9rpx 0}.swiss-summary-team>text{font-size:22rpx;color:#8a93a6}.swiss-unplaced{margin:24rpx;padding:24rpx;background:#fff;border-radius:18rpx}.swiss-unplaced-match{padding:18rpx 0;border-bottom:1rpx solid #eef0f5;font-size:26rpx}.swiss-footer{margin:24rpx;font-size:21rpx;color:#8a93a6;line-height:1.8}
